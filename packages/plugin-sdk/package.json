{
  "name": "@openforge-app/plugin-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "default": "./dist/frontend.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package-metadata-schema.json": "./dist/openforgePackageMetadataSchema.json",
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./prStatusPresentation": {
      "types": "./dist/prStatusPresentation.d.ts",
      "default": "./dist/prStatusPresentation.js"
    },
    "./projectFileTree": {
      "types": "./dist/projectFileTree.d.ts",
      "default": "./dist/projectFileTree.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./numberParsing": {
      "types": "./dist/numberParsing.d.ts",
      "default": "./dist/numberParsing.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "default": "./dist/sanitize.js"
    },
    "./fileIcons": {
      "types": "./dist/fileIcons.d.ts",
      "default": "./dist/fileIcons.js"
    },
    "./ui/MarkdownContent.svelte": "./dist/ui/MarkdownContent.svelte",
    "./ui/ResizablePanel.svelte": "./dist/ui/ResizablePanel.svelte",
    "./ui/Modal.svelte": "./dist/ui/Modal.svelte",
    "./ui/PluginPageHeader.svelte": "./dist/ui/PluginPageHeader.svelte",
    "./ui/PluginViewState.svelte": "./dist/ui/PluginViewState.svelte",
    "./ui/FileTypeIcon.svelte": "./dist/ui/FileTypeIcon.svelte"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm run clean && tsc && pnpm run build:assets",
    "build:assets": "node ./scripts/copy-package-assets.mjs",
    "icons:generate": "node ./scripts/generate-file-type-icons.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "marked": "^18.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vscode-material-icons": "^0.1.1"
  }
}
