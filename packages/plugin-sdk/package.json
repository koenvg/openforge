{
  "name": "@openforge/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "default": "./dist/frontend.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package-metadata-schema.json": "./dist/openforgePackageMetadataSchema.json",
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./numberParsing": {
      "types": "./dist/numberParsing.d.ts",
      "default": "./dist/numberParsing.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "default": "./dist/sanitize.js"
    },
    "./ui/MarkdownContent.svelte": "./dist/ui/MarkdownContent.svelte",
    "./ui/ResizablePanel.svelte": "./dist/ui/ResizablePanel.svelte"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm run clean && tsc && pnpm run build:assets",
    "build:assets": "node ./scripts/copy-package-assets.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "marked": "^17.0.3"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
