{
  "name": "@openforge-app/plugin-sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for building trusted OpenForge frontend and backend plugins.",
  "homepage": "https://github.com/koenvg/openforge/blob/main/docs/plugin-authoring.md",
  "keywords": [
    "openforge",
    "plugin",
    "sdk",
    "svelte"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koenvg/openforge.git",
    "directory": "packages/plugin-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "default": "./dist/frontend.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package-metadata-schema.json": "./dist/openforgePackageMetadataSchema.json",
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./prStatusPresentation": {
      "types": "./dist/prStatusPresentation.d.ts",
      "default": "./dist/prStatusPresentation.js"
    },
    "./projectFileTree": {
      "types": "./dist/projectFileTree.d.ts",
      "default": "./dist/projectFileTree.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./numberParsing": {
      "types": "./dist/numberParsing.d.ts",
      "default": "./dist/numberParsing.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "default": "./dist/sanitize.js"
    },
    "./pluginIcons": {
      "types": "./dist/pluginIcons.d.ts",
      "default": "./dist/pluginIcons.js"
    },
    "./fileIcons": {
      "types": "./dist/fileIcons.d.ts",
      "default": "./dist/fileIcons.js"
    },
    "./collapsibleSectionState": {
      "types": "./dist/collapsibleSectionState.d.ts",
      "default": "./dist/collapsibleSectionState.js"
    },
    "./taskBrowserDevToolsShortcuts": {
      "types": "./dist/taskBrowserDevToolsShortcuts.d.ts",
      "default": "./dist/taskBrowserDevToolsShortcuts.js"
    },
    "./ui/Button.svelte": "./dist/ui/Button.svelte",
    "./ui/IconButton.svelte": "./dist/ui/IconButton.svelte",
    "./ui/TextField.svelte": "./dist/ui/TextField.svelte",
    "./ui/Textarea.svelte": "./dist/ui/Textarea.svelte",
    "./ui/Checkbox.svelte": "./dist/ui/Checkbox.svelte",
    "./ui/Switch.svelte": "./dist/ui/Switch.svelte",
    "./ui/Badge.svelte": "./dist/ui/Badge.svelte",
    "./ui/Panel.svelte": "./dist/ui/Panel.svelte",
    "./ui/MarkdownContent.svelte": "./dist/ui/MarkdownContent.svelte",
    "./ui/ResizablePanel.svelte": "./dist/ui/ResizablePanel.svelte",
    "./ui/Modal.svelte": "./dist/ui/Modal.svelte",
    "./ui/PluginPageHeader.svelte": "./dist/ui/PluginPageHeader.svelte",
    "./ui/PluginPageShell.svelte": "./dist/ui/PluginPageShell.svelte",
    "./ui/PluginViewState.svelte": "./dist/ui/PluginViewState.svelte",
    "./ui/PluginSidebarLink.svelte": "./dist/ui/PluginSidebarLink.svelte",
    "./ui/FileTypeIcon.svelte": "./dist/ui/FileTypeIcon.svelte",
    "./ui/ProjectFileTree.svelte": "./dist/ui/ProjectFileTree.svelte",
    "./ui/CollapsibleSection.svelte": "./dist/ui/CollapsibleSection.svelte"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "check:entrypoints": "node ./scripts/check-entrypoint-registries.mjs",
    "build": "pnpm run check:entrypoints && pnpm run clean && tsc && pnpm run build:assets",
    "build:assets": "node ./scripts/copy-package-assets.mjs",
    "check:contract": "node ./scripts/check-published-contract.mjs",
    "icons:generate": "node ./scripts/generate-file-type-icons.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check:contract",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "catalog:",
    "github-slugger": "catalog:",
    "marked": "catalog:",
    "mermaid": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:pinned",
    "svelte": "catalog:pinned",
    "semver": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vscode-material-icons": "^0.1.1"
  }
}
