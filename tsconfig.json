{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@openforge/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@openforge/plugin-sdk/backend": ["packages/plugin-sdk/src/backend.ts"],
      "@openforge/plugin-sdk/domain": ["packages/plugin-sdk/src/domain.ts"],
      "@openforge/plugin-sdk/frontend": ["packages/plugin-sdk/src/frontend.ts"],
      "@openforge/plugin-sdk/markdown": ["packages/plugin-sdk/src/markdown.ts"],
      "@openforge/plugin-sdk/numberParsing": ["packages/plugin-sdk/src/numberParsing.ts"],
      "@openforge/plugin-sdk/package-metadata-schema.json": ["packages/plugin-sdk/src/openforgePackageMetadataSchema.json"],
      "@openforge/plugin-sdk/sanitize": ["packages/plugin-sdk/src/sanitize.ts"],
      "@openforge/plugin-sdk/testing": ["packages/plugin-sdk/src/testing.ts"],
      "@openforge/plugin-sdk/ui/MarkdownContent.svelte": ["packages/plugin-sdk/src/ui/MarkdownContent.svelte"],
      "@openforge/plugin-sdk/ui/ResizablePanel.svelte": ["packages/plugin-sdk/src/ui/ResizablePanel.svelte"],
      "@openforge/plugin-sdk/vite": ["packages/plugin-sdk/src/vite.ts"],
      "@openforge/terminal-runtime": ["packages/terminal-runtime/src/index.ts"],
      "@openforge/terminal-runtime/terminalRuntime": ["packages/terminal-runtime/src/terminalRuntime.ts"],
      "@openforge/terminal-runtime/terminalOptions": ["packages/terminal-runtime/src/terminalOptions.ts"],
      "@openforge/terminal-runtime/theme": ["packages/terminal-runtime/src/theme.ts"],
      "@openforge/terminal-runtime/shortcuts": ["packages/terminal-runtime/src/terminalShortcuts.ts"],
      "@openforge/terminal-runtime/shortcutController": ["packages/terminal-runtime/src/terminalShortcutController.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
