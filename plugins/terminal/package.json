{
  "name": "@openforge-app/plugin-terminal",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@openforge-app/plugin-sdk": "workspace:*",
    "@openforge-app/terminal-runtime": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "openforge": {
    "id": "com.openforge.terminal",
    "apiVersion": 1,
    "displayName": "Terminal",
    "description": "Embedded terminal with PTY management and agent panels",
    "icon": "terminal",
    "frontend": "./dist/frontend.js",
    "requires": [
      "views",
      "taskPane",
      "tasks",
      "shell",
      "events",
      "config",
      "system.openUrl"
    ]
  }
}
