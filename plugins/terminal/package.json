{
  "name": "@openforge/plugin-terminal",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@openforge/plugin-sdk": "workspace:*",
    "@openforge/terminal-runtime": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.3",
    "svelte": "^5.56.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "openforge": {
    "id": "com.openforge.terminal",
    "apiVersion": 1,
    "displayName": "Terminal",
    "description": "Embedded terminal with PTY management and agent panels",
    "icon": "terminal",
    "frontend": "./dist/frontend.js",
    "requires": [
      "views",
      "taskPane",
      "tasks",
      "shell",
      "events",
      "config",
      "system.openUrl"
    ]
  }
}
