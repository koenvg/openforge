{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@openforge/terminal-runtime": ["../../packages/terminal-runtime/src/index.ts"],
      "@openforge/terminal-runtime/terminalRuntime": ["../../packages/terminal-runtime/src/terminalRuntime.ts"],
      "@openforge/terminal-runtime/terminalOptions": ["../../packages/terminal-runtime/src/terminalOptions.ts"],
      "@openforge/terminal-runtime/theme": ["../../packages/terminal-runtime/src/theme.ts"],
      "@openforge/terminal-runtime/shortcuts": ["../../packages/terminal-runtime/src/terminalShortcuts.ts"],
      "@openforge/terminal-runtime/shortcutController": ["../../packages/terminal-runtime/src/terminalShortcutController.ts"],
      "@openforge/terminal-runtime/xterm.css": ["../../packages/terminal-runtime/src/xterm.css"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src"]
}
