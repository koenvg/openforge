{
  "name": "@openforge/plugin-roadmap",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build && vite build --config vite.backend.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@openforge/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.3",
    "svelte": "^5.56.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "openforge": {
    "id": "com.openforge.roadmap",
    "apiVersion": 1,
    "displayName": "Roadmap",
    "description": "A per-repository Kanban board over GitHub Issues",
    "icon": "kanban",
    "frontend": "./dist/frontend.js",
    "backend": "./dist/backend.js",
    "requires": [
      "views",
      "backend",
      "commands",
      "events",
      "system.openUrl",
      "navigation",
      "context"
    ]
  }
}
