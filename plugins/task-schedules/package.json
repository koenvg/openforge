{
  "name": "@openforge-app/plugin-task-schedules",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build && vite build --config vite.backend.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "@openforge-app/plugin-sdk": "workspace:*",
    "cronstrue": "^3.24.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "openforge": {
    "id": "com.openforge.task-schedules",
    "apiVersion": 1,
    "displayName": "Task Schedules",
    "description": "Create one-off or recurring project Task Schedules that create and optionally start Tasks.",
    "icon": "clock",
    "frontend": "./dist/frontend.js",
    "backend": "./dist/backend.mjs",
    "requires": [
      "views",
      "backend",
      "background",
      "commands",
      "storage",
      "context",
      "navigation",
      "tasks"
    ]
  }
}
