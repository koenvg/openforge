{
  "name": "@openforge-app/plugin-skills-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build && vite build --config vite.backend.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@openforge-app/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "openforge": {
    "id": "com.openforge.skills-viewer",
    "apiVersion": 1,
    "displayName": "Skills Viewer",
    "description": "Browse and manage AI skills",
    "icon": "sparkles",
    "frontend": "./dist/frontend.js",
    "backend": "./dist/backend.js",
    "requires": [
      "views",
      "backend",
      "projects",
      "navigation",
      "system.openUrl",
      "context",
      "commands",
      "storage"
    ]
  }
}
