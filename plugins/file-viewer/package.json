{
  "name": "@openforge-app/plugin-file-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "@openforge-app/plugin-sdk": "workspace:*",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "openforge": {
    "id": "com.openforge.file-viewer",
    "apiVersion": 1,
    "displayName": "File Viewer",
    "description": "Browse and preview project and task worktree files",
    "icon": "folder-open",
    "frontend": "./dist/frontend.js",
    "frontendStyles": ["./dist/file-viewer.css"],
    "requires": [
      "views",
      "taskPane",
      "commands",
      "fs",
      "tasks",
      "navigation",
      "system.openUrl",
      "context"
    ]
  }
}
