{
  "name": "@openforge/plugin-file-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.21.0",
    "@openforge/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.0.0",
    "svelte": "^5.56.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "openforge": {
    "id": "com.openforge.file-viewer",
    "apiVersion": 1,
    "displayName": "File Viewer",
    "description": "Browse and preview project files",
    "icon": "folder-open",
    "frontend": "./dist/frontend.js",
    "requires": [
      "views",
      "commands",
      "fs",
      "system.openUrl",
      "context"
    ]
  }
}
