{
  "name": "@openforge/plugin-github-sync",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build && vite build --config vite.backend.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@openforge/plugin-sdk": "workspace:*",
    "@openforge/pr-review-ui": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.19.33",
    "svelte": "^5.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "openforge": {
    "id": "com.openforge.github-sync",
    "apiVersion": 1,
    "displayName": "GitHub Sync",
    "description": "Review pull requests assigned to you",
    "icon": "git-pull-request",
    "frontend": "./dist/frontend.js",
    "backend": "./dist/backend.js",
    "requires": [
      "views",
      "backend",
      "commands",
      "events",
      "system.openUrl",
      "projectConfig",
      "context"
    ]
  }
}
