{
  "name": "@openforge-app/plugin-github-sync",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm run build:bundle",
    "build:bundle": "vite build && vite build --config vite.backend.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.28.0",
    "@openforge-app/plugin-sdk": "workspace:*",
    "@openforge-app/pr-review-ui": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.2",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "openforge": {
    "id": "com.openforge.github-sync",
    "apiVersion": 1,
    "displayName": "GitHub Sync",
    "description": "Review pull requests assigned to you",
    "icon": "git-pull-request",
    "frontend": "./dist/frontend.js",
    "backend": "./dist/backend.js",
    "frontendStyles": ["./dist/plugin-github-sync.css"],
    "requires": [
      "taskPane",
      "views",
      "backend",
      "commands",
      "events",
      "storage",
      "system.openUrl",
      "projectConfig",
      "context"
    ]
  }
}
