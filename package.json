{
  "name": "openforge",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ghostty:prepare": "node scripts/prepare-ghostty-vt.mjs",
    "build:plugin-sdk-runtime": "node scripts/build-plugin-sdk-runtime.mjs",
    "build:plugins": "pnpm --filter @openforge-app/plugin-sdk build && pnpm -r --filter './plugins/*' --if-present build:bundle",
    "dev:plugin-artifacts": "node scripts/build-dev-plugin-artifacts.mjs",
    "dev": "vite",
    "website:dev": "pnpm --filter @openforge-app/website dev",
    "website:check": "pnpm --filter @openforge-app/website check",
    "website:build": "pnpm --filter @openforge-app/website build",
    "website:preview": "pnpm --filter @openforge-app/website preview",
    "website:deploy": "pnpm --filter @openforge-app/website exec astro build --outDir ../../dist",
    "electron:contract:generate": "node scripts/generate-desktop-ipc-registry.mjs",
    "electron:contract:check": "node scripts/generate-desktop-ipc-registry.mjs --check",
    "electron:build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm electron:contract:generate && node scripts/electron-build.mjs",
    "electron:package": "node scripts/electron-package.mjs",
    "electron:install": "bash scripts/install-electron-mac.sh",
    "electron:smoke:packaged": "node scripts/electron-packaged-smoke.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:test-app": "node scripts/desktop-test-app.mjs",
    "performance:terminal:full-app": "node scripts/terminal-performance-full-app.mjs",
    "e2e:dev": "node scripts/e2e-invariants.mjs --dev",
    "e2e:invariants": "node scripts/e2e-invariants.mjs",
    "performance:terminal:profiler-off": "RUN_TERMINAL_PERFORMANCE_OVERHEAD=1 vitest run packages/terminal-runtime/src/terminalPerformanceOverheadBenchmark.test.ts",
    "build": "pnpm build:plugin-sdk-runtime && vite build --configLoader native",
    "lint": "node scripts/check-svelte-unused-imports.mjs && node scripts/check-plugin-import-boundaries.mjs",
    "markdown:visual": "RUN_MARKDOWN_VISUALS=1 vitest run packages/pr-review-ui/src/RichMarkdownDiff.visual.test.ts",
    "mobile:contract:generate": "node scripts/generate-companion-dart-client.mjs",
    "mobile:contract:check": "node scripts/check-companion-dart-contract.mjs",
    "packages:build": "pnpm --filter @openforge-app/plugin-sdk build && pnpm --filter @openforge-app/terminal-runtime build",
    "packages:test": "pnpm --filter @openforge-app/plugin-sdk test && pnpm --filter @openforge-app/terminal-runtime test",
    "packages:contract:check": "pnpm --filter @openforge-app/plugin-sdk check:contract",
    "packages:metadata:check": "node scripts/check-workspace-package-metadata.mjs",
    "packages:pack:dry-run": "pnpm packages:metadata:check && node scripts/pack-npm-packages-dry-run.mjs",
    "preview": "vite preview",
    "terminal:presentation": "node packages/terminal-runtime/conformance/run.mjs",
    "performance:idle": "node scripts/check-idle-resources.mjs",
    "terminal:presentation:update": "node packages/terminal-runtime/conformance/run.mjs --update-baselines",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@git-diff-view/core": "catalog:",
    "@git-diff-view/svelte": "catalog:",
    "@lucide/svelte": "catalog:",
    "@openforge-app/plugin-runtime": "workspace:*",
    "@openforge-app/plugin-sdk": "workspace:*",
    "@openforge-app/pr-review-ui": "workspace:*",
    "@openforge-app/terminal-runtime": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/virtual-core": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-image": "catalog:",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/addon-webgl": "catalog:",
    "@xterm/xterm": "catalog:",
    "daisyui": "^5.7.22",
    "dompurify": "catalog:",
    "es-module-lexer": "2.3.2",
    "marked": "catalog:",
    "qrcode": "^1.5.4",
    "svelte": "catalog:",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@babel/types": "catalog:",
    "@git-diff-view/lowlight": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "electron": "^43.4.1",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "semver": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
