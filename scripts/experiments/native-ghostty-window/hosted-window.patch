diff --git a/src/apprt/hosted.zig b/src/apprt/hosted.zig
new file mode 100644
index 0000000..d03d1b5
--- /dev/null
+++ b/src/apprt/hosted.zig
@@ -0,0 +1,114 @@
+//! Local experiment API for a host-owned native surface.
+const std = @import("std");
+const embedded = @import("embedded.zig");
+const renderer = @import("../renderer.zig");
+const termio = @import("../termio.zig");
+const String = @import("../main_c.zig").String;
+const log = std.log.scoped(.hosted_surface);
+
+pub const Config = extern struct {
+    userdata: ?*anyopaque,
+    owner_token: u64,
+    output_offset: u64,
+    width_px: u32,
+    height_px: u32,
+    snapshot: ?[*]const u8,
+    snapshot_len: usize,
+    write_cb: ?*const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+    resize_cb: ?*const fn (?*anyopaque, u16, u16, u32, u32) callconv(.c) void,
+
+    fn valid(self: Config) bool {
+        return self.owner_token != 0 and self.write_cb != null and
+            self.width_px > 0 and self.width_px <= 16384 and
+            self.height_px > 0 and self.height_px <= 16384 and
+            self.snapshot_len <= @import("../termio/HostedRestore.zig").snapshot_limit and
+            (self.snapshot_len == 0 or self.snapshot != null);
+    }
+};
+
+pub const History = extern struct {
+    rows_applied: u64 = 0,
+    remaining: u32 = 0,
+    finished: bool = false,
+    history_lost: bool = false,
+};
+
+pub fn backend(surface: *embedded.Surface) termio.Backend {
+    const config = surface.host_config.?;
+    return .{ .host = .{
+        .userdata = surface,
+        .instance_id = config.owner_token,
+        .output_offset = config.output_offset,
+        .write = write,
+        .on_resize = resize,
+    } };
+}
+
+fn write(ptr: ?*anyopaque, bytes: []const u8) void {
+    const surface: *embedded.Surface = @ptrCast(@alignCast(ptr.?));
+    const config = surface.host_config.?;
+    config.write_cb.?(config.userdata, bytes.ptr, bytes.len);
+}
+
+fn resize(ptr: ?*anyopaque, grid: renderer.GridSize, screen: renderer.ScreenSize) void {
+    const surface: *embedded.Surface = @ptrCast(@alignCast(ptr.?));
+    const config = surface.host_config.?;
+    if (config.resize_cb) |callback| callback(config.userdata, grid.columns, grid.rows, screen.width, screen.height);
+}
+
+pub const CAPI = struct {
+    export fn ghostty_surface_new_hosted(app_: ?*embedded.App, opts_: ?*const embedded.Surface.Options, config_: ?*const Config) ?*embedded.Surface {
+        const app = app_ orelse return null;
+        const opts = opts_ orelse return null;
+        const config = config_ orelse return null;
+        if (!config.valid()) return null;
+        const surface = app.core_app.alloc.create(embedded.Surface) catch return null;
+        surface.initWithHost(app, opts.*, config.*) catch |err| {
+            log.warn("hosted surface creation failed: {}", .{err});
+            app.core_app.alloc.destroy(surface);
+            return null;
+        };
+        return surface;
+    }
+
+    export fn ghostty_surface_hosted_output(surface_: ?*embedded.Surface, owner: u64, offset: u64, bytes: ?[*]const u8, len: usize) bool {
+        const surface = surface_ orelse return false;
+        const slice = if (bytes) |ptr| ptr[0..len] else if (len == 0) "" else return false;
+        surface.core_surface.io.processHostedOutput(owner, offset, slice) catch return false;
+        return true;
+    }
+
+    export fn ghostty_surface_hosted_snapshot(surface_: ?*embedded.Surface, result: *String) bool {
+        result.* = .empty;
+        const surface = surface_ orelse return false;
+        var writer: std.Io.Writer.Allocating = .init(surface.app.core_app.alloc);
+        defer writer.deinit();
+        surface.core_surface.io.writeHostedSnapshot(&writer.writer) catch |err| {
+            log.warn("hosted snapshot refused: {}", .{err});
+            return false;
+        };
+        const bytes = writer.toOwnedSlice() catch return false;
+        result.* = .{ .ptr = bytes.ptr, .len = bytes.len, .sentinel = false };
+        return true;
+    }
+
+    export fn ghostty_surface_hosted_next_history(surface_: ?*embedded.Surface, result: *History) bool {
+        result.* = .{};
+        const surface = surface_ orelse return false;
+        const io = &surface.core_surface.io;
+        const progress = io.nextHostedHistory() catch {
+            result.history_lost = true;
+            return false;
+        };
+        if (progress) |value| {
+            result.rows_applied = value.rows;
+            result.remaining = value.remaining;
+        } else result.finished = true;
+        result.history_lost = io.host_history_lost;
+        return true;
+    }
+
+    export fn ghostty_surface_hosted_cancel_history(surface: *embedded.Surface) void {
+        surface.core_surface.io.cancelHostedHistory();
+    }
+};
