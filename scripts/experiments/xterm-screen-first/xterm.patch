@@ -849,6 +849,24 @@ export class CoreBrowserTerminal extends CoreTerminal implements ITerminal {
    * @param start The row to start from (between 0 and this.rows - 1).
    * @param end The row to end at (between start and this.rows - 1).
    */
+  public prependPlainTextHistory(rows: readonly string[]): void {
+    const buffer = this.buffer;
+    if (buffer !== this._bufferService.buffers.normal || buffer.lines.length + rows.length > buffer.lines.maxLength) {
+      throw new Error('Unsupported screen or exhausted history retention');
+    }
+    const lines = rows.map(text => {
+      const line = buffer.getBlankLine(DEFAULT_ATTR_DATA);
+      for (let x = 0; x < text.length; x++) { line.setCellFromCodepoint(x, text.charCodeAt(x), 1, DEFAULT_ATTR_DATA); }
+      return line;
+    });
+    buffer.lines.splice(0, 0, ...lines);
+    buffer.ybase += lines.length;
+    buffer.ydisp += lines.length;
+    buffer.savedY += lines.length;
+    this._onScroll.fire({ position: buffer.ydisp });
+    this.refresh(0, this.rows - 1);
+  }
+
   public refresh(start: number, end: number): void {
     this._renderService?.refreshRows(start, end);
   }
