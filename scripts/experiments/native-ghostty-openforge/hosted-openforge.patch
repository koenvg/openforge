-/// Process output from the pty. This is the manual API that users can
-/// call with pty data but it is also called by the read thread when using
-/// an exec subprocess.
+/// Export the native owner and parser at one cut. A partial restore cannot
+/// masquerade as a complete checkpoint after cancellation or discarded pages.
+pub fn writeHostedSnapshot(self: *Termio, writer: *std.Io.Writer) !void {
+    const Restore = @import("HostedRestore.zig");
+    if (self.backend != .host) return error.NotHostBackend;
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (self.host_restore != null or self.host_history_lost) return error.HistoryIncomplete;
+    var screens = self.terminal.screens.all.iterator();
+    while (screens.next()) |entry| {
+        const images = &entry.value.*.kitty_images;
+        if (images.images.count() != 0 or images.placements.count() != 0) return error.ImagesNotCheckpointed;
+    }
+    var continuation: std.Io.Writer.Allocating = .init(self.alloc);
+    defer continuation.deinit();
+    try self.terminal_stream.writeContinuation(&continuation.writer);
+    const bytes = continuation.written();
+    try Restore.snapshot.encode(self.alloc, writer, &self.terminal, .{
+        .continuation = if (bytes.len == 0) .ground else .{ .bytes = bytes },
+    });
+}
+
+/// Apply at most one history page to the same native terminal the renderer
+/// reads. FINISH says the stream was consumed, not that every row was applied.
+pub fn nextHostedHistory(self: *Termio) !?@import("HostedRestore.zig").snapshot.Decoder.Progress {
+    if (self.backend != .host) return error.NotHostBackend;
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const restore = self.host_restore orelse return null;
+    const result = restore.decoder.next(self.alloc, &self.terminal) catch |err| {
+        restore.destroy();
+        self.host_restore = null;
+        self.host_history_lost = true;
+        return err;
+    };
+    if (result) |progress| {
+        if (progress.rows == 0) self.host_history_lost = true;
+        try self.terminal_stream.handler.queueRender();
+    } else {
+        restore.destroy();
+        self.host_restore = null;
+    }
+    return result;
+}
+
+pub fn cancelHostedHistory(self: *Termio) void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (self.host_restore) |restore| {
+        restore.destroy();
+        self.host_restore = null;
+        self.host_history_lost = true;
+    }
+}
+
+/// The host serializes output calls. The accepted offset is a parsed-byte
+/// acknowledgement only; it says nothing about presentation to a user.
+pub fn processHostedOutput(self: *Termio, instance_id: u64, offset: u64, bytes: []const u8) !void {
+    if (self.backend != .host) return error.NotHostBackend;
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const host = &self.backend.host;
+    if (host.instance_id != instance_id) return error.StaleInstance;
+    if (host.output_offset != offset) return error.OutputOffsetMismatch;
+    const next = std.math.add(u64, offset, bytes.len) catch return error.OutputOffsetOverflow;
+    self.processOutputLocked(bytes);
+    host.output_offset = next;
+}
+
