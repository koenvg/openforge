new file mode 100644
index 0000000..0e4089e
--- /dev/null
+++ b/src/termio/HostedRestore.zig
@@ -0,0 +1,46 @@
+//! Owns a bounded, in-memory snapshot and its incremental decoder.
+//! Heap allocation keeps Decoder.source stable. Termio owns the adopted
+//! Terminal by value at its final address; this object never owns a Stream.
+const HostedRestore = @This();
+const std = @import("std");
+pub const snapshot = @import("../terminal/snapshot/snapshot.zig");
+const global = @import("../global.zig");
+
+pub const continuation_limit = 64 * 1024;
+pub const snapshot_limit = 128 * 1024 * 1024;
+alloc: std.mem.Allocator,
+bytes: []u8,
+reader: std.Io.Reader,
+decoder: snapshot.Decoder,
+decoded: snapshot.Decoded,
+
+pub fn create(alloc: std.mem.Allocator, bytes: []const u8) !*HostedRestore {
+    if (bytes.len > snapshot_limit) return error.SnapshotTooLarge;
+    const self = try alloc.create(HostedRestore);
+    errdefer alloc.destroy(self);
+    const owned = try alloc.dupe(u8, bytes);
+    errdefer alloc.free(owned);
+    self.* = .{ .alloc = alloc, .bytes = owned, .reader = .fixed(owned), .decoder = undefined, .decoded = undefined };
+    self.decoder = .init(&self.reader);
+    self.decoded = try self.decoder.ready(alloc, global.io(), .{ .max_continuation_bytes = continuation_limit });
+    return self;
+}
+
+pub fn destroy(self: *HostedRestore) void {
+    const alloc = self.alloc;
+    self.decoded.deinit(alloc);
+    alloc.free(self.bytes);
+    alloc.destroy(self);
+}
+
+pub fn replay(self: *HostedRestore, stream: anytype) !void {
+    const bytes = switch (self.decoded.continuation) {
+        .ground => "",
+        .bytes => |value| value,
+    };
+    stream.nextSlice(bytes);
+    var exported: std.Io.Writer.Allocating = .init(self.alloc);
+    defer exported.deinit();
+    try stream.writeContinuation(&exported.writer);
+    if (!std.mem.eql(u8, bytes, exported.written())) return error.InvalidContinuation;
+}
