diff --git a/include/ghostty-hosted.h b/include/ghostty-hosted.h
new file mode 100644
index 0000000..7ce33f7
--- /dev/null
+++ b/include/ghostty-hosted.h
@@ -0,0 +1,52 @@
+// Experimental fork API. Not part of upstream Ghostty or OpenForge production.
+#pragma once
+#include "ghostty.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Calls run on the main thread EXCEPT hosted_output: serialize it on one worker,
+// retain its surface through completion, and keep ticking the app on main. Parsing
+// may wait for app-mailbox capacity; main-thread parsing can deadlock.
+// Do not mutate/export history or state while that output call is in progress.
+// Callbacks may run on native/host workers: copy borrowed bytes, enqueue host work,
+// and never reenter Ghostty. Join host output work before surface_free, which joins
+// native threads; retain userdata until both have finished.
+typedef struct {
+  void* userdata;
+  uint64_t owner_token;
+  uint64_t output_offset;
+  uint32_t width_px;
+  uint32_t height_px;
+  const uint8_t* snapshot;
+  size_t snapshot_len;
+  void (*write_cb)(void*, const uint8_t*, size_t);
+  void (*resize_cb)(void*, uint16_t, uint16_t, uint32_t, uint32_t);
+  // False in OpenForge. Only explicitly user-originated writes reach write_cb.
+  bool protocol_replies;
+} ghostty_host_config_s;
+
+typedef struct {
+  uint64_t rows_applied;
+  uint32_t remaining;
+  bool finished;
+  bool history_lost;
+} ghostty_host_history_s;
+
+typedef struct { uint16_t columns; uint16_t rows; } ghostty_host_grid_s;
+// Actual parsed grid; use to await resize before feeding output. Not pixel evidence.
+GHOSTTY_API bool ghostty_surface_hosted_grid(ghostty_surface_t, ghostty_host_grid_s*);
+
+GHOSTTY_API ghostty_surface_t ghostty_surface_new_hosted(
+    ghostty_app_t, const ghostty_surface_config_s*, const ghostty_host_config_s*);
+GHOSTTY_API bool ghostty_surface_hosted_output(
+    ghostty_surface_t, uint64_t, uint64_t, const uint8_t*, size_t);
+// Free a successful binary result with ghostty_string_free, not strlen/free.
+GHOSTTY_API bool ghostty_surface_hosted_snapshot(ghostty_surface_t, ghostty_string_s*);
+GHOSTTY_API bool ghostty_surface_hosted_next_history(ghostty_surface_t, ghostty_host_history_s*);
+GHOSTTY_API void ghostty_surface_hosted_cancel_history(ghostty_surface_t);
+
+#ifdef __cplusplus
+}
+#endif
