+pub fn nextHostedHistory(self: *Termio) !?@import("HostedRestore.zig").snapshot.Decoder.Progress {
+    if (self.backend != .host) return error.NotHostBackend;
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const restore = self.host_restore orelse return null;
+    const result = restore.decoder.next(self.alloc, &self.terminal) catch |err| {
+        restore.destroy();
+        self.host_restore = null;
+        self.host_history_lost = true;
+        return err;
