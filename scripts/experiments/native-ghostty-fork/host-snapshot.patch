+const Surface = @import("../Surface.zig");
+const Config = @import("../config.zig").Config;
+const global = @import("../global.zig");
+
+const Fixture = struct {
+    io: termio.Termio = undefined,
+    mutex: std.Io.Mutex = .init,
+    state: renderer.State = undefined,
+    wakeup: global.xev.Async,
+    render_queue: *renderer.Thread.Mailbox,
+    app_queue: *App.Mailbox.Queue,
+    app: apprt.App = .{},
+    // Never dereferenced: the headless fixture only queues surface messages.
+    surface: Surface = undefined,
+    writes: std.Io.Writer.Allocating,
+
+    fn create(snapshot: ?[]const u8) !*Fixture {
+        const alloc = testing.allocator;
+        const self = try alloc.create(Fixture);
+        errdefer alloc.destroy(self);
+        var wakeup = try global.xev.Async.init();
+        errdefer wakeup.deinit();
+        const render_queue = try renderer.Thread.Mailbox.create(alloc);
+        errdefer render_queue.destroy(alloc);
+        const app_queue = try App.Mailbox.Queue.create(alloc);
+        errdefer app_queue.destroy(alloc);
+        self.* = .{
+            .wakeup = wakeup,
+            .render_queue = render_queue,
+            .app_queue = app_queue,
+            .writes = .init(alloc),
+        };
+        self.state = .{ .mutex = &self.mutex, .terminal = &self.io.terminal };
+        var config = try Config.default(alloc);
+        defer config.deinit();
+        var derived = try termio.DerivedConfig.init(alloc, &config);
+        errdefer derived.deinit();
+        var mailbox = try termio.Mailbox.initSPSC(alloc);
+        errdefer mailbox.deinit(alloc);
+        try self.io.init(alloc, .{
+            .size = .{ .screen = .{ .width = 800, .height = 400 }, .cell = .{ .width = 10, .height = 20 }, .padding = .{} },
+            .full_config = &config,
+            .config = derived,
+            .host_snapshot = snapshot,
+            .backend = .{ .host = .{ .userdata = self, .write = write, .instance_id = 17 } },
+            .mailbox = mailbox,
+            .renderer_state = &self.state,
+            .renderer_wakeup = wakeup,
