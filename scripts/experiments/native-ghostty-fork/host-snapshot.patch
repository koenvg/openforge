+test "hosted: a protocol query yields one native-owned reply" {
+    const f = try Fixture.create(null);
+    defer f.destroy();
+    var thread = try termio.Thread.init(testing.allocator);
+    defer thread.deinit();
+    var td: termio.Termio.ThreadData = undefined;
+    try f.io.threadEnter(&thread, &td);
+    defer f.io.threadExit(&td);
+    try f.output("\x1b[6n");
+    // Drain the actual native mailbox synchronously, without a GUI event loop.
+    while (f.io.mailbox.spsc.queue.pop(global.io())) |message| {
+        defer message.deinit();
+        switch (message) {
+            .write_small => |v| try f.io.queueWrite(&td, v.data[0..v.len], false),
+            .write_stable => |v| try f.io.queueWrite(&td, v, false),
+            .write_alloc => |v| try f.io.queueWrite(&td, v.data, false),
+            else => return error.UnexpectedMessage,
+        }
+    }
+    try testing.expectEqualStrings("\x1b[1;1R", f.writes.written());
+}
