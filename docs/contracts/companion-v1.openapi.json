{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenForge Companion API",
    "version": "1.0.0",
    "description": "Purpose-built HTTP boundary for the OpenForge Mobile Companion. Pairing request submission bootstraps trust; authenticated resources expose narrow desktop-authoritative Companion capabilities without generic command dispatch or sensitive desktop state."
  },
  "servers": [
    { "url": "/companion/v1" }
  ],
  "paths": {
    "/pairing/requests": {
      "post": {
        "operationId": "submitCompanionPairingRequest",
        "summary": "Submit a device request with a short-lived one-time pairing secret",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PairingSubmission" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The device is awaiting desktop approval",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PairingSubmissionStatus" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/CompanionError" },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "413": { "$ref": "#/components/responses/CompanionError" },
          "410": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/pairing/requests/{requestId}": {
      "get": {
        "operationId": "getCompanionPairingRequest",
        "summary": "Poll for the trusted desktop's pairing decision",
        "security": [],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^Pairing " }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was approved and the one-time credential is returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PairingPoll" }
              }
            }
          },
          "202": {
            "description": "The request is still awaiting desktop approval",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PairingPoll" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "403": { "$ref": "#/components/responses/CompanionError" },
          "410": { "$ref": "#/components/responses/CompanionError" },
          "413": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getCompanionHostStatus",
        "summary": "Read the paired desktop host identity and protocol status",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" }
        ],
        "responses": {
          "200": {
            "description": "The Companion Gateway is available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HostStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "404": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/attention": {
      "get": {
        "operationId": "getCompanionAttention",
        "summary": "Read the backend-authoritative Task Needs Attention snapshot",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" }
        ],
        "responses": {
          "200": {
            "description": "Current normalized Task attention rows in authoritative order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AttentionSnapshot" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "getCompanionProjects",
        "summary": "Read visible Projects in desktop sidebar order",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" }
        ],
        "responses": {
          "200": {
            "description": "Visible Project identifiers and names in desktop order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectCatalog" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/projects/{projectId}/board": {
      "get": {
        "operationId": "getCompanionProjectBoard",
        "summary": "Read one backend-authoritative Project Board snapshot",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" },
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative four-lane Board snapshot for the requested visible Project",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectBoard" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "404": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/tasks/{taskId}": {
      "get": {
        "operationId": "getCompanionTaskDetail",
        "summary": "Read the approved Task detail fields",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Current non-mutating Task detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskDetail" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "404": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/tasks/{taskId}/complete": {
      "post": {
        "operationId": "completeCompanionTask",
        "summary": "Complete one active Task through the shared terminal lifecycle",
        "description": "Authenticated Task-scoped mutation. The server validates Project visibility, current doing state, and lifecycle claims; stops the Agent and Task shells; retains Completed Task reference data; and schedules safe worktree and owned-branch cleanup. Clients must not automatically retry this mutation after transport uncertainty.",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task reference data completed and cleanup accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskCompleteResult" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "404": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/tasks/{taskId}/delete": {
      "post": {
        "operationId": "deleteCompanionBacklogTask",
        "summary": "Delete one current backlog Task using terminal completion semantics",
        "description": "This explicit mutation is never automatically retried. The desktop verifies Task ownership, visible Project policy, current backlog state, and the per-Task lifecycle claim before preserving the Completed Task as reference data and scheduling normal runtime cleanup.",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "The backlog Task reached the terminal Completed Task lifecycle",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskDeleteReceipt" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/CompanionError" },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "404": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/tasks/{taskId}/start": {
      "post": {
        "operationId": "startCompanionTask",
        "summary": "Start one backlog Task using authoritative saved defaults",
        "description": "Identity-only Companion Task Start. The client must not automatically retry this mutation or fail it over to another endpoint. After an uncertain transport outcome it refetches Task detail and the Project Board before offering another Start.",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "An Implementation Run was started and authoritative resources will invalidate",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskStartResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/CompanionError" },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "404": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "streamCompanionEvents",
        "summary": "Stream coarse Task and attention resource invalidations while foregrounded",
        "description": "Authenticated SSE stream backed by the OpenForge App Event Bus. Event data never contains internal event payloads, Handoff Notes, credentials, provider identifiers, or Agent-session identifiers. Clients refetch the named resources. Last-Event-ID resumes from the App Event Bus replay cursor when available; stream-gap requires discarding in-memory domain views and fetching fresh snapshots.",
        "security": [{ "companionDeviceBearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CompanionProtocolVersion" },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "description": "Opaque cursor from the last received SSE id field.",
            "schema": { "type": "string", "minLength": 3 }
          }
        ],
        "x-sse-events": [
          {
            "event": "resources-invalidated",
            "dataSchema": { "$ref": "#/components/schemas/ResourceInvalidationData" }
          },
          {
            "event": "stream-gap",
            "dataSchema": { "$ref": "#/components/schemas/StreamGapData" }
          },
          {
            "event": "authorization-revoked",
            "dataSchema": { "$ref": "#/components/schemas/AuthorizationRevokedData" },
            "terminal": true
          },
          {
            "event": "gateway-closing",
            "dataSchema": { "$ref": "#/components/schemas/GatewayClosingData" },
            "terminal": true
          }
        ],
        "responses": {
          "200": {
            "description": "SSE invalidation stream. Every replayable event has an opaque id cursor.",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/CompanionError" },
          "401": { "$ref": "#/components/responses/CompanionError" },
          "409": { "$ref": "#/components/responses/CompanionError" },
          "429": { "$ref": "#/components/responses/CompanionError" },
          "503": { "$ref": "#/components/responses/CompanionError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "companionDeviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "OpenForge companion device credential"
      }
    },
    "parameters": {
      "CompanionProtocolVersion": {
        "name": "openforge-companion-protocol-version",
        "in": "header",
        "required": true,
        "description": "Major Companion protocol version. Device authentication is evaluated before compatibility so this header never bypasses trust.",
        "schema": { "type": "integer", "const": 1 }
      }
    },
    "schemas": {
      "PairingSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secret", "deviceName", "platform"],
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "deviceName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "platform": { "type": "string", "enum": ["ios", "android"] }
        }
      },
      "PairingSubmissionStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "status", "expiresAt"],
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "const": "pending" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "PairingPoll": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["pending", "approved"] },
          "deviceId": { "type": "string", "format": "uuid" },
          "credential": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "approved" } } },
            "then": { "required": ["deviceId", "credential"] }
          },
          {
            "if": { "properties": { "status": { "const": "pending" } } },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["deviceId"] },
                  { "required": ["credential"] }
                ]
              }
            }
          }
        ]
      },
      "HostStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostId", "protocolVersion", "serverTime"],
        "properties": {
          "hostId": { "type": "string", "format": "uuid" },
          "protocolVersion": { "type": "integer", "const": 1 },
          "serverTime": { "type": "string", "format": "date-time" }
        }
      },
      "AttentionSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshotAt", "items"],
        "properties": {
          "snapshotAt": { "type": "string", "format": "date-time" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AttentionItem" }
          }
        }
      },
      "AttentionItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "projectId",
          "projectName",
          "title",
          "state",
          "reason",
          "activityAt"
        ],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "projectId": { "type": "string", "minLength": 1 },
          "projectName": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "activityAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProjectCatalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "name"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "ProjectCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotAt", "projects"],
      "properties": {
        "snapshotAt": { "type": "string", "format": "date-time" },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/ProjectCatalogItem" }
        }
      }
    },
    "ProjectBoardLane": {
      "type": "string",
      "enum": ["focus", "in_flight", "out_of_focus", "backlog"]
    },
    "ProjectBoardTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "title", "lane", "state", "reason", "activityAt"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "lane": { "$ref": "#/components/schemas/ProjectBoardLane" },
        "state": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "activityAt": { "type": "string", "format": "date-time" }
      }
    },
    "ProjectBoardCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "inFlight", "outOfFocus", "backlog"],
      "properties": {
        "focus": { "type": "integer", "minimum": 0 },
        "inFlight": { "type": "integer", "minimum": 0 },
        "outOfFocus": { "type": "integer", "minimum": 0 },
        "backlog": { "type": "integer", "minimum": 0 }
      }
    },
    "ProjectBoardLanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "inFlight", "outOfFocus", "backlog"],
      "properties": {
        "focus": { "type": "array", "items": { "$ref": "#/components/schemas/ProjectBoardTask" } },
        "inFlight": { "type": "array", "items": { "$ref": "#/components/schemas/ProjectBoardTask" } },
        "outOfFocus": { "type": "array", "items": { "$ref": "#/components/schemas/ProjectBoardTask" } },
        "backlog": { "type": "array", "items": { "$ref": "#/components/schemas/ProjectBoardTask" } }
      }
    },
    "ProjectBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotAt", "projectId", "projectName", "counts", "lanes"],
      "properties": {
        "snapshotAt": { "type": "string", "format": "date-time" },
        "projectId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "minLength": 1 },
        "counts": { "$ref": "#/components/schemas/ProjectBoardCounts" },
        "lanes": { "$ref": "#/components/schemas/ProjectBoardLanes" }
      }
    },
    "TaskDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "title",
          "projectId",
          "projectName",
          "boardStatus",
          "handoffNotes",
          "agentState",
          "agentTerminalAvailable",
          "agentErrorSummary",
          "createdAt",
          "updatedAt",
          "agentUpdatedAt"
        ],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "projectId": { "type": "string", "minLength": 1 },
          "projectName": { "type": "string", "minLength": 1 },
          "boardStatus": {
            "type": "string",
            "enum": ["backlog", "doing", "done"]
          },
          "handoffNotes": { "type": ["string", "null"] },
          "agentState": {
            "type": "string",
            "enum": ["waiting", "running", "blocked", "failed", "complete"]
          },
          "agentTerminalAvailable": { "type": "boolean" },
          "agentErrorSummary": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "agentUpdatedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "TaskCompleteResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "boardStatus", "cleanupScheduled"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "boardStatus": { "const": "done" },
          "cleanupScheduled": { "type": "boolean" }
        }
      },
      "TaskDeleteReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "outcome"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "const": "deleted" }
        }
      },
      "TaskStartResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "outcome"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "outcome": { "const": "started" }
        }
      },
      "ResourceInvalidationData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resources"],
        "properties": {
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": { "kind": { "const": "attention" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": {
                    "kind": { "const": "project_catalog" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "id"],
                  "properties": {
                    "kind": { "const": "project_board" },
                    "id": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "id"],
                  "properties": {
                    "kind": { "const": "task" },
                    "id": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          }
        }
      },
      "StreamGapData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refreshRequired"],
        "properties": { "refreshRequired": { "const": true } }
      },
      "AuthorizationRevokedData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": { "reason": { "const": "revoked" } }
      },
      "GatewayClosingData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": { "reason": { "const": "shutdown" } }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthenticated",
          "revoked",
          "incompatible_version",
          "invalid_request",
          "invalid_task_state",
          "operation_in_progress",
          "not_found",
          "invalid_state",
          "desktop_action_required",
          "rate_limited",
          "temporarily_unavailable"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
