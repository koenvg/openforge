---
import { FINAL_CTA_LINKS } from '../../lib/landingContent';
import LandingActions from './LandingActions.astro';
---

<section class="landing-section final-cta" aria-labelledby="final-cta-title" data-animate-section>
  <div class="final-cta-copy">
    <h2 id="final-cta-title" class="section-title">Run agent work from one desktop.</h2>
    <p class="final-cta-lede">
      Install OpenForge to keep parallel coding agents visible, reviewable, and under your control.
    </p>

    <LandingActions links={FINAL_CTA_LINKS} ariaLabel="Final actions" class="final-cta-actions" />
  </div>
</section>
