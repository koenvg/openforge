---
import { PLUGIN_CAPABILITIES } from '../../lib/landingContent';
import './PluginCustomizationSection.css';
---

<section id="plugins" class="landing-section plugin-customization" aria-labelledby="plugin-customization-title" data-animate-section>
  <div class="plugin-customization-heading">
    <h2 id="plugin-customization-title" class="section-title">Plugins belong in the architecture.</h2>
    <p class="section-intro">
      Add views, task context, and automations through explicit extension points. The core task system stays stable while your control plane grows.
    </p>
    <a class="text-link" href="https://www.npmjs.com/package/@openforge-app/plugin-sdk">
      Explore the plugin SDK
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
    </a>
  </div>

  <div class="plugin-system">
    <div class="plugin-architecture" aria-label={`OpenForge core connected to ${PLUGIN_CAPABILITIES.length} first-class plugin extension points`}>
      <div class="plugin-architecture-grid" aria-hidden="true"></div>
      <svg class="plugin-pipes" viewBox="0 0 1000 680" preserveAspectRatio="none" aria-hidden="true">
        <g class="plugin-pipes-base">
          {PLUGIN_CAPABILITIES.map((capability) => <path d={capability.pipePath} />)}
        </g>
        <g class="plugin-pipes-active">
          {PLUGIN_CAPABILITIES.map((capability) => (
            <path class={`theme-${capability.theme}`} data-plugin-pipe pathLength="1" d={capability.pipePath} />
          ))}
        </g>
      </svg>

      <div class="plugin-core" data-plugin-core>
        <img src="/app-icon.svg" width="52" height="52" alt="" />
        <div>
          <strong>OpenForge core</strong>
          <span>Tasks · runs · review</span>
        </div>
        {PLUGIN_CAPABILITIES.map((capability) => (
          <i class={`core-port core-port-${capability.slot} theme-${capability.theme}`} aria-hidden="true"></i>
        ))}
      </div>

      <ol class="plugin-nodes">
        {PLUGIN_CAPABILITIES.map((capability) => (
          <li class={`plugin-node plugin-node-${capability.slot} theme-${capability.theme}`} data-plugin-node>
            <span class="plugin-node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {capability.iconPaths.map((path) => <path d={path} />)}
              </svg>
            </span>
            <div>
              <h3>{capability.title}</h3>
              <code>{capability.code}</code>
              <p>{capability.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="plugin-architecture-note">{PLUGIN_CAPABILITIES.length} extension points. One stable core.</p>
    </div>
  </div>
</section>
