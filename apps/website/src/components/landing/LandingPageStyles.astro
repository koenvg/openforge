---
---

<style is:global>
  main {
    position: relative;
  }

  .hero-shell,
  .landing-section,
  .site-footer {
    width: min(100% - 3rem, 88rem);
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 5.25rem;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 680;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .wordmark-mark {
    display: grid;
    grid-template-columns: repeat(2, 0.38rem);
    gap: 0.1rem;
    padding: 0.28rem;
    border: 1px solid var(--ink);
    background: var(--ink);
  }

  .wordmark-mark > span {
    width: 0.38rem;
    height: 0.38rem;
    background: var(--surface);
  }

  .wordmark-mark > span:nth-child(2),
  .wordmark-mark > span:nth-child(3) {
    opacity: 0.45;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-nav a,
  .header-github,
  .site-footer nav a {
    color: var(--muted-strong);
    font-size: 0.82rem;
    font-weight: 540;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-nav a:hover,
  .header-github:hover,
  .site-footer nav a:hover {
    color: var(--ink);
  }

  .header-github {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.4rem;
  }

  .header-github svg,
  .text-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(28rem, 1.08fr);
    min-height: 47rem;
    overflow: hidden;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
    background: rgba(251, 251, 250, 0.86);
    isolation: isolate;
  }

  .hero-grid-lines {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(to right, transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px)),
      linear-gradient(to bottom, transparent calc(100% - 5.6rem - 0.5px), var(--line) calc(100% - 5.6rem), transparent calc(100% - 5.6rem + 0.5px));
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    align-self: center;
    padding: 6rem 2.25rem 9rem 4.5rem;
  }

  .hero-kicker,
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.6rem;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-kicker > span {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 0.25rem rgba(8, 168, 130, 0.1);
  }

  #hero-title {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.45rem, 5.5vw, 6.55rem);
    font-weight: 560;
    letter-spacing: -0.072em;
    line-height: 0.94;
  }

  #hero-title span {
    color: var(--muted);
  }

  .lede {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: var(--muted-strong);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-actions {
    margin-top: 2.1rem;
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.62rem;
    padding: 0.72rem 1.1rem;
    border: 1px solid transparent;
    font-size: 0.84rem;
    font-weight: 620;
    letter-spacing: -0.012em;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button:active {
    transform: translateY(0);
  }

  .button-primary {
    border-color: var(--ink);
    background: var(--ink);
    box-shadow: 0 0.45rem 1.4rem rgba(17, 19, 24, 0.14);
    color: white;
  }

  .button-primary:hover {
    border-color: var(--blue);
    background: var(--blue);
    box-shadow: 0 0.65rem 1.8rem rgba(41, 71, 255, 0.2);
  }

  .button-secondary {
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.78);
    color: var(--ink);
  }

  .button-secondary:hover {
    border-color: var(--ink);
    background: var(--surface);
  }

  .button-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .download-icon {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .hero-proof {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.6rem;
    color: var(--muted);
    font-size: 0.67rem;
    font-weight: 580;
  }

  .hero-proof > span {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-proof ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-proof li {
    position: relative;
    padding-left: 0.75rem;
    color: var(--muted-strong);
  }

  .hero-proof li::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 50%;
    background: var(--line-strong);
    content: "";
    transform: translateY(-50%);
  }

  .hero-visual {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 41.4rem;
    overflow: hidden;
    border-left: 1px solid var(--line);
    background: var(--surface);
  }

  .hero-canvas,
  .hero-visual-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-canvas {
    z-index: 2;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .hero-visual[data-vgpu-ready="true"] .hero-canvas {
    opacity: 1;
  }

  .hero-visual-fallback {
    background:
      radial-gradient(circle at 55% 48%, rgba(98, 126, 255, 0.34), transparent 8%),
      radial-gradient(ellipse at 54% 48%, transparent 24%, rgba(52, 89, 255, 0.42) 24.2%, transparent 25%),
      radial-gradient(ellipse at 53% 49%, transparent 34%, rgba(139, 92, 246, 0.28) 34.2%, transparent 35%),
      linear-gradient(160deg, white, #f1f4ff 45%, #fafafa 72%);
  }

  .hero-visual-fallback::before,
  .hero-visual-fallback::after {
    position: absolute;
    border: 1px solid rgba(41, 71, 255, 0.24);
    border-radius: 50%;
    content: "";
    transform: rotate(-16deg);
  }

  .hero-visual-fallback::before {
    inset: 24% 14%;
  }

  .hero-visual-fallback::after {
    inset: 34% 25%;
    border-color: rgba(8, 168, 130, 0.28);
    transform: rotate(22deg);
  }

  .hero-orbit-label {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(17, 19, 24, 0.14);
    background: rgba(255, 255, 255, 0.76);
    box-shadow: var(--shadow-small);
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.025em;
    backdrop-filter: blur(12px);
  }

  .hero-orbit-label span {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 0 0.22rem rgba(41, 71, 255, 0.1);
  }

  .hero-orbit-label-top {
    top: 17%;
    right: 10%;
  }

  .hero-orbit-label-bottom {
    right: 17%;
    bottom: 18%;
  }

  .hero-orbit-label-bottom span {
    background: var(--mint);
    box-shadow: 0 0 0 0.22rem rgba(8, 168, 130, 0.1);
  }

  .hero-status-strip {
    position: absolute;
    z-index: 5;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    min-height: 5.6rem;
    border-top: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
  }

  .hero-status-strip > div {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.48rem;
    padding: 1rem;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .hero-status-strip > div:last-child {
    border-right: 0;
  }

  .hero-status-strip strong {
    color: var(--ink);
    font-size: 0.78rem;
  }

  .status-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 0.25rem rgba(8, 168, 130, 0.1);
  }

  .landing-section {
    position: relative;
    padding: clamp(7rem, 10vw, 10rem) 4.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .section-heading-split {
    display: grid;
    grid-template-columns: 0.48fr 1.25fr 0.68fr;
    align-items: start;
    gap: 2rem;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4.4vw, 4.6rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }

  .section-intro,
  .final-cta-lede {
    margin: 0;
    color: var(--muted-strong);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .reason-rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    list-style: none;
  }

  .reason-step {
    min-width: 0;
    border-right: 1px solid var(--line);
  }

  .reason-step:last-child {
    border-right: 0;
  }

  .reason-card {
    min-height: 29rem;
    padding: 1.35rem 1.35rem 1.8rem;
    background: rgba(255, 255, 255, 0.44);
    transition: background-color 200ms ease;
  }

  .reason-card:hover {
    background: var(--surface);
  }

  .reason-card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-badge {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .reason-signal {
    display: flex;
    gap: 0.2rem;
  }

  .reason-signal i {
    width: 0.26rem;
    height: 0.26rem;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .reason-diagram {
    position: relative;
    height: 13rem;
    margin: 2.2rem 0 2rem;
    overflow: hidden;
    border: 1px solid var(--line);
    background-color: var(--surface-soft);
    background-image:
      linear-gradient(rgba(17, 19, 24, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 24, 0.055) 1px, transparent 1px);
    background-size: 1.3rem 1.3rem;
  }

  .reason-diagram span {
    position: absolute;
    display: block;
    border: 1px solid var(--ink);
    background: white;
    box-shadow: 0.28rem 0.28rem 0 rgba(17, 19, 24, 0.09);
  }

  .reason-diagram-1 span:nth-child(1) {
    top: 2rem;
    left: 2rem;
    width: 42%;
    height: 2rem;
  }

  .reason-diagram-1 span:nth-child(2) {
    top: 5rem;
    left: 2rem;
    width: 68%;
    height: 0.7rem;
    border-color: var(--blue);
    background: var(--blue);
    box-shadow: none;
  }

  .reason-diagram-1 span:nth-child(3) {
    top: 7.25rem;
    left: 2rem;
    width: 54%;
    height: 0.7rem;
    border-color: var(--line-strong);
    box-shadow: none;
  }

  .reason-diagram-1 span:nth-child(4) {
    right: 1.75rem;
    bottom: 1.5rem;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border-color: var(--mint);
    background: rgba(8, 168, 130, 0.12);
  }

  .reason-diagram-2 span {
    width: 3.4rem;
    height: 4.8rem;
  }

  .reason-diagram-2 span:nth-child(1) {
    top: 4rem;
    left: 1.8rem;
    border-color: var(--blue);
  }

  .reason-diagram-2 span:nth-child(2) {
    top: 2.2rem;
    left: calc(50% - 1.7rem);
    border-color: var(--violet);
  }

  .reason-diagram-2 span:nth-child(3) {
    top: 4.9rem;
    right: 1.8rem;
    border-color: var(--mint);
  }

  .reason-diagram-2 span:nth-child(4) {
    top: 6.3rem;
    left: 18%;
    width: 64%;
    height: 1px;
    border: 0;
    border-top: 1px dashed var(--line-strong);
    background: transparent;
    box-shadow: none;
  }

  .reason-diagram-3 span:nth-child(1) {
    inset: 1.8rem 2.2rem;
  }

  .reason-diagram-3 span:nth-child(2),
  .reason-diagram-3 span:nth-child(3) {
    left: 3.4rem;
    width: calc(100% - 6.8rem);
    height: 0.62rem;
    border: 0;
    box-shadow: none;
  }

  .reason-diagram-3 span:nth-child(2) {
    top: 4.7rem;
    background: linear-gradient(90deg, var(--mint) 62%, var(--line) 62%);
  }

  .reason-diagram-3 span:nth-child(3) {
    top: 6.5rem;
    background: linear-gradient(90deg, var(--blue) 78%, var(--line) 78%);
  }

  .reason-diagram-3 span:nth-child(4) {
    right: 3rem;
    bottom: 2.6rem;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    border-color: var(--mint);
    background: var(--mint);
    box-shadow: 0 0 0 0.4rem rgba(8, 168, 130, 0.11);
  }

  .reason-card h3 {
    margin: 0;
    font-size: 1.32rem;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .reason-card > p {
    max-width: 26rem;
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .product-proof {
    padding-bottom: 0;
    background: var(--surface);
  }

  .product-stage {
    position: relative;
    min-height: 55rem;
    margin: 5rem -4.5rem 0;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(circle at 40% 46%, rgba(41, 71, 255, 0.1), transparent 27rem),
      linear-gradient(180deg, #f6f7f8, #eef0f3);
  }

  .product-stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(17, 19, 24, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 19, 24, 0.055) 1px, transparent 1px);
    background-size: 2.7rem 2.7rem;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }

  .product-window {
    position: absolute;
    z-index: 2;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(17, 19, 24, 0.2);
    background: #12151b;
    box-shadow: var(--shadow-window);
  }

  .product-window-board {
    top: 6.5rem;
    left: 5.5%;
    width: 72%;
    transform: rotate(-1.2deg);
  }

  .product-window-review {
    right: 5%;
    bottom: 5.5rem;
    width: 48%;
    transform: rotate(1.6deg);
  }

  .window-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 2.4rem;
    padding: 0 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: #171a21;
    color: rgba(255, 255, 255, 0.64);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .window-bar > div {
    display: flex;
    gap: 0.32rem;
  }

  .window-bar > div span {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.24);
  }

  .window-bar p {
    margin: 0;
  }

  .window-status {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.35rem;
  }

  .window-status i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: #59d59b;
  }

  .product-window img {
    width: 100%;
    height: auto;
  }

  .product-callout {
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 0.26rem;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product-callout span {
    color: var(--blue);
  }

  .product-callout-left {
    bottom: 8rem;
    left: 4.5%;
  }

  .product-callout-right {
    top: 4.2rem;
    right: 4.5%;
    text-align: right;
  }

  .product-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0 -4.5rem;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .product-facts li {
    display: grid;
    gap: 0.36rem;
    padding: 1.65rem 2rem;
    border-right: 1px solid var(--line);
  }

  .product-facts li:last-child {
    border-right: 0;
  }

  .product-facts strong {
    font-size: 0.9rem;
    font-weight: 620;
  }

  .product-facts span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .plugin-customization {
    display: grid;
    grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
    gap: 5rem;
    background:
      radial-gradient(circle at 84% 35%, rgba(139, 92, 246, 0.1), transparent 23rem),
      var(--background);
  }

  .plugin-customization-heading {
    align-self: start;
    position: sticky;
    top: 3rem;
  }

  .plugin-customization-heading .section-title {
    max-width: 10ch;
  }

  .plugin-customization-heading .section-intro {
    max-width: 27rem;
    margin-top: 1.5rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.8rem;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 620;
    text-decoration: none;
  }

  .text-link::after {
    position: absolute;
    width: 0;
    content: "";
  }

  .plugin-system {
    min-width: 0;
  }

  .plugin-code-card,
  .capability-ledger {
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-medium);
  }

  .plugin-code-card {
    overflow: hidden;
  }

  .code-card-bar,
  .code-card-output {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.8rem;
    padding: 0 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .code-card-bar {
    border-bottom: 1px solid var(--line);
    background: var(--surface-soft);
  }

  .plugin-code-card pre {
    margin: 0;
    overflow-x: auto;
    padding: 2rem 1.6rem;
    background: #11141a;
    color: #d9dee8;
    font-family: var(--font-mono);
    font-size: clamp(0.67rem, 1vw, 0.77rem);
    line-height: 1.9;
  }

  .code-keyword,
  .code-function {
    color: #aebaff;
  }

  .code-property {
    color: #8ce5ca;
  }

  .code-string {
    color: #f3bf7d;
  }

  .code-card-output {
    border-top: 1px solid var(--line);
  }

  .code-card-output > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
  }

  .code-card-output i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--mint);
  }

  .capability-ledger {
    margin-top: 1rem;
    box-shadow: var(--shadow-small);
  }

  .ledger-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ledger-row {
    display: grid;
