---
---

<style is:global>
  :root {
    --landing-gutter: clamp(2rem, 6vw, 6.5rem);
    --landing-container-wide: 96rem;
    --landing-title-size: clamp(3rem, 5vw, 5.1rem);
    --landing-title-compact-size: clamp(2.45rem, 13vw, 3.25rem);
  }

  @media (max-width: 62rem) {
    :root {
      --landing-gutter: 2.5rem;
    }
  }

  @media (max-width: 35rem) {
    :root {
      --landing-gutter: 2rem;
      --landing-title-size: var(--landing-title-compact-size);
    }
  }

  .hero-shell {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: clamp(1.25rem, 2.7vw, 3rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 9% 88%, var(--hero-dot) 0 0.18rem, transparent 0.2rem) 0 0 / 2rem 2rem,
      linear-gradient(124deg, var(--hero-blue) 0 51%, var(--hero-paper) 51% 100%);
    color: var(--hero-ink);
    font-family: var(--font-display);
  }

  .site-header {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .wordmark {
    position: relative;
    z-index: 2;
    color: var(--hero-paper);
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 1.8vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
    text-shadow: var(--shadow-hero-text);
  }

  .hero {
    position: relative;
    width: min(100%, 99rem);
    min-height: calc(100dvh - 5rem);
    display: grid;
    grid-template-columns: minmax(24rem, 0.92fr) minmax(28rem, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 5rem);
    margin: 0 auto;
  }

  .hero::after {
    content: "";
    position: absolute;
    right: max(-8vw, -7rem);
    bottom: max(-10vw, -9rem);
    width: min(28rem, 34vw);
    aspect-ratio: 1;
    border-radius: 32% 68% 0 0;
    background: var(--hero-ink);
    transform: rotate(-18deg);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(100%, 47rem);
    padding-block: clamp(3rem, 7vh, 5.5rem);
  }

  h1 {
    max-width: 10.6em;
    margin: 0;
    color: var(--hero-paper);
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 6.25vw, 6.55rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.052em;
    text-wrap: balance;
    text-shadow: var(--shadow-hero-title);
  }

  .lede {
    max-width: 39rem;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    color: var(--hero-text-soft);
    font-size: clamp(1.16rem, 1.45vw, 1.45rem);
    font-weight: 500;
    line-height: 1.48;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .button {
    min-height: 3.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    border: 1.5px solid var(--line);
    border-radius: 0.55rem;
    padding: 0 2rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    border-color: var(--green);
    background: linear-gradient(180deg, var(--green-bright), var(--green));
    box-shadow: var(--shadow-button);
    color: #ffffff;
  }

  .button-primary:hover {
    box-shadow: var(--shadow-button-hover);
  }

  .button-secondary {
    background: var(--surface-paper-soft);
  }

  .button-secondary:hover {
    border-color: var(--green);
    background: var(--surface-paper-strong);
  }

  .hero .button {
    min-height: clamp(3.6rem, 5vw, 4.6rem);
    border: 2px solid var(--hero-ink);
    border-radius: 0.8rem;
    padding-inline: clamp(1.4rem, 2.4vw, 2.35rem);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    font-weight: 750;
    box-shadow: var(--shadow-hero-button);
  }

  .hero .button-primary {
    background: var(--hero-ink);
    color: var(--hero-paper);
  }

  .hero .button-secondary {
    background: var(--hero-paper);
    color: var(--hero-ink);
  }

  .hero .button:hover {
    box-shadow: var(--shadow-hero-button-hover);
  }

  .button-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  @media (max-width: 35rem) {
    .actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }

  .bento-stage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) clamp(2.65rem, 3.4vw, 3.25rem) minmax(12rem, 1fr);
    grid-template-rows: minmax(12.5rem, 1fr) clamp(2.65rem, 3.4vw, 3.25rem) minmax(12.5rem, 1fr);
    gap: clamp(0.55rem, 1vw, 0.95rem);
    align-items: stretch;
  }

  .bento-stage::before {
    content: "";
    position: absolute;
    inset: -4rem -6rem -3rem 7%;
    z-index: -1;
    border-radius: 5rem 0 0 5rem;
    background: var(--hero-paper);
    transform: skewX(-11deg);
  }

  .bento-card {
    position: relative;
    min-height: clamp(12.5rem, 16vw, 16rem);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(0.7rem, 1.1vw, 1rem);
    border: 3px solid var(--hero-ink);
    border-radius: 1.2rem;
    padding: clamp(1rem, 1.65vw, 1.45rem);
    box-shadow: var(--shadow-bento);
    color: var(--hero-ink);
    text-align: center;
  }

  .bento-card-task {
    grid-column: 1;
    grid-row: 1;
    background: var(--hero-card-task);
  }

  .bento-card-agent {
    grid-column: 3;
    grid-row: 1;
    background: var(--hero-card-agent);
  }

  .bento-card-handoff {
    grid-column: 3;
    grid-row: 3;
    background: var(--hero-card-handoff);
  }

  .bento-card-review {
    grid-column: 1;
    grid-row: 3;
    background: var(--hero-card-review);
  }

  .flow-arrow {
    position: relative;
    z-index: 4;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .flow-line {
    position: absolute;
    border-radius: 999rem;
    background: var(--hero-ink);
  }

  .flow-dot {
    position: relative;
    z-index: 2;
    width: clamp(2.35rem, 3.25vw, 3rem);
    height: clamp(2.35rem, 3.25vw, 3rem);
    display: grid;
    place-items: center;
    border: 3px solid var(--hero-ink);
    border-radius: 999rem;
    background: var(--hero-ink);
    color: var(--hero-paper);
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    font-weight: 700;
    line-height: 1;
    box-shadow: var(--shadow-flow-dot);
  }

  .flow-arrow-task-agent {
    grid-column: 2;
    grid-row: 1;
  }

  .flow-arrow-task-agent .flow-line,
  .flow-arrow-handoff-review .flow-line {
    width: calc(100% + clamp(1rem, 1.6vw, 1.6rem));
    height: 0.22rem;
  }

  .flow-arrow-agent-handoff {
    grid-column: 3;
    grid-row: 2;
  }

  .flow-arrow-agent-handoff .flow-line {
    width: 0.22rem;
    height: calc(100% + clamp(1rem, 1.6vw, 1.6rem));
  }

  .flow-arrow-handoff-review {
    grid-column: 2;
    grid-row: 3;
  }

  .bento-label {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.45vw, 2.55rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .bento-card svg {
    width: clamp(2.9rem, 4.2vw, 4.25rem);
    height: clamp(2.9rem, 4.2vw, 4.25rem);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .bento-card p {
    max-width: 12rem;
    margin: 0;
    font-size: clamp(0.98rem, 1.05vw, 1.05rem);
    font-weight: 700;
    line-height: 1.3;
  }

  @media (max-width: 62rem) {
    .hero-shell {
      min-height: auto;
      padding: 1.25rem;
      overflow: hidden;
      background: linear-gradient(180deg, var(--hero-blue) 0 56%, var(--hero-paper) 56% 100%);
    }

    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }

    .hero::after {
      width: 18rem;
      right: -8rem;
      bottom: -7rem;
    }

    .hero-copy {
      width: 100%;
      padding-block: clamp(2.6rem, 8vw, 4.5rem) 0;
    }

    h1 {
      max-width: 9ch;
    }

    .bento-stage {
      grid-template-columns: minmax(0, 1fr) 2.7rem minmax(0, 1fr);
      grid-template-rows: minmax(11.5rem, auto) 2.7rem minmax(11.5rem, auto);
      max-width: 44rem;
      margin: 0 auto;
      padding-block: 2rem 3rem;
    }

    .bento-stage::before {
      inset: 0 -3rem;
      border-radius: 2.5rem;
      transform: none;
    }

    .bento-card {
      min-height: 11.5rem;
    }
  }

  @media (max-width: 35rem) {
    .hero-shell {
      background: linear-gradient(180deg, var(--hero-blue) 0 54%, var(--hero-paper) 54% 100%);
    }

    .bento-stage {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      padding-block: 1.5rem 2.5rem;
    }

    .bento-stage::before {
      inset: 0 -1rem;
    }

    .bento-card-task,
    .bento-card-agent,
    .bento-card-handoff,
    .bento-card-review {
      grid-column: auto;
      grid-row: auto;
    }

    .flow-arrow {
      display: none;
    }

    .bento-card {
      min-height: auto;
      margin: 0;
      box-shadow: var(--shadow-bento-compact);
    }
  }

  .landing-section {
    width: min(100% - var(--landing-section-gutter, var(--landing-gutter)), var(--landing-section-max, var(--landing-container-wide)));
    margin-inline: auto;
  }

  .section-heading {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: var(--green-deep);
    font-size: 0.82rem;
    font-weight: 780;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-title {
    max-width: 13em;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--section-title-size, var(--landing-title-size));
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.058em;
  }

  @media (max-width: 62rem) {
    .section-heading {
      justify-items: start;
      text-align: left;
    }

    .section-title {
      max-width: 10em;
    }
  }

  .top-reasons {
    --landing-section-max: 94rem;
    padding: clamp(4.5rem, 8vw, 7.5rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .reason-rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2vw, 1.6rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .reason-rail::before {
    display: none;
  }

  .reason-step {
    position: relative;
    min-width: 0;
  }

  .step-badge {
    width: fit-content;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--border-green-medium);
    border-radius: 999rem;
    padding: 0.35rem 0.65rem;
    background: var(--glow-green-badge);
    color: var(--green-deep);
    font-family: var(--font-code);
    font-size: 0.82rem;
    font-weight: 760;
  }

  .reason-card {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--border-soft);
    border-radius: 1rem;
    padding: clamp(1.25rem, 2vw, 1.8rem);
    background: var(--surface-paper-card);
    box-shadow: none;
  }

  .reason-card h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 2.1vw, 2.25rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.052em;
  }

  .reason-card p {
    max-width: 27rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.5;
  }

  @media (max-width: 62rem) {
    .top-reasons {
      --landing-section-max: 44rem;
      padding-top: clamp(3.75rem, 10vw, 5rem);
    }

    .reason-rail {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 2rem;
      padding: 0;
    }

    .reason-rail::before {
      display: none;
    }

    .reason-card {
      position: relative;
    }

    .reason-card h3,
    .reason-card p {
      max-width: 100%;
    }
  }

  @media (max-width: 35rem) {
    .top-reasons {
      --landing-section-max: 32rem;
    }

    .reason-card {
      padding: 1rem;
    }
  }

  .product-proof {
    --section-title-size: clamp(3.15rem, 5.2vw, 5.6rem);
    display: grid;
    grid-template-columns: minmax(20rem, 0.95fr) minmax(24rem, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 6.25rem);
    padding: clamp(3rem, 5vw, 4.5rem) 0 clamp(3.5rem, 6vw, 5rem);
    overflow: visible;
  }

  .product-proof-copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.15rem;
  }

  .product-proof-copy .section-title {
    max-width: 8.8em;
  }

  .proof-lede {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.08rem, 1.4vw, 1.42rem);
    line-height: 1.45;
  }

  .proof-figure {
    position: relative;
    z-index: 1;
    min-width: 0;
    max-width: 32rem;
    justify-self: center;
    margin: 0;
    perspective: 80rem;
  }

  .proof-figure::before {
    display: none;
  }

  .proof-screenshot-shell {
    position: relative;
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 1.05rem;
    background: var(--surface-proof-dark);
    box-shadow: var(--shadow-card);
    transform: none;
    transform-origin: center;
  }

  .proof-screenshot-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, var(--surface-proof-sheen-light), transparent 28%, transparent 74%, var(--surface-proof-sheen-dark));
  }

  .proof-screenshot {
    width: auto;
    max-width: 100%;
    max-height: min(68dvh, 40rem);
    display: block;
  }

  @media (max-width: 62rem) {
    .product-proof {
      --landing-section-max: 54rem;
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-top: clamp(3.75rem, 10vw, 5rem);
    }

    .product-proof-copy .section-title {
      max-width: 10em;
    }

    .proof-figure {
      max-width: min(100%, 30rem);
      justify-self: center;
    }

    .proof-screenshot-shell {
      transform: none;
    }
  }

  @media (max-width: 35rem) {
    .product-proof {
      --landing-section-max: 32rem;
      --section-title-size: var(--landing-title-size);
    }

    .proof-figure {
      max-width: min(100%, 26rem);
    }
  }

  .plugin-customization {
    --landing-section-max: 92rem;
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(4.5rem, 8vw, 7.25rem) 0 clamp(5.25rem, 9vw, 8rem);
  }

  .plugin-customization::before {
    content: "";
    position: absolute;
    inset: clamp(3.5rem, 7vw, 6rem) max(-6vw, -5rem) auto auto;
    z-index: -1;
    width: min(24rem, 32vw);
    aspect-ratio: 1;
    border: 3px solid var(--hero-ink);
    border-radius: 2rem;
    background: var(--hero-card-agent);
    box-shadow: var(--shadow-bento-compact);
    transform: rotate(8deg);
    opacity: 0.45;
  }

  .plugin-customization-heading {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .plugin-customization-heading .section-title {
    max-width: 10.8em;
  }

  .plugin-customization-lede {
    max-width: 52rem;
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.18rem, 1.7vw, 1.62rem);
    font-weight: 620;
    line-height: 1.42;
  }

  .capability-ledger {
    position: relative;
    max-width: 84rem;
    margin: clamp(2.5rem, 5vw, 3.75rem) auto 0;
    border: 3px solid var(--hero-ink);
    border-radius: clamp(1.25rem, 2vw, 1.8rem);
    padding: clamp(0.95rem, 2vw, 1.45rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 9% 88%, var(--hero-dot) 0 0.16rem, transparent 0.18rem) 0 0 / 1.7rem 1.7rem,
      linear-gradient(128deg, var(--hero-blue) 0 42%, var(--hero-paper) 42% 100%);
    box-shadow: var(--shadow-bento);
  }

  .capability-ledger::before {
    content: "";
    position: absolute;
    inset: auto -2rem -4rem auto;
    width: min(22rem, 42vw);
    aspect-ratio: 1;
    border-radius: 38% 62% 0 0;
    background: var(--hero-ink);
    transform: rotate(-17deg);
    pointer-events: none;
  }

  .ledger-list {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.45vw, 1.15rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ledger-row {
    position: relative;
    min-width: 0;
    min-height: clamp(13rem, 17vw, 16.5rem);
    display: grid;
    align-content: space-between;
    gap: clamp(1.1rem, 2vw, 1.6rem);
    grid-column: span 3;
    border: 3px solid var(--hero-ink);
    border-radius: clamp(1rem, 1.6vw, 1.3rem);
    padding: clamp(1.05rem, 1.9vw, 1.55rem);
    background: var(--hero-card-task);
    color: var(--hero-ink);
    box-shadow: var(--shadow-bento-compact);
  }

  .ledger-row:nth-child(2) {
    background: var(--hero-card-agent);
  }

  .ledger-row:nth-child(3) {
    grid-column: span 2;
    background: var(--hero-blue);
    color: var(--hero-paper);
  }

  .ledger-row:nth-child(4) {
    grid-column: span 4;
    background: var(--hero-card-review);
  }

  .ledger-icon {
    width: clamp(3rem, 4.4vw, 4.15rem);
    height: clamp(3rem, 4.4vw, 4.15rem);
    display: grid;
    place-items: center;
    border: 3px solid var(--hero-ink);
    border-radius: 0.9rem;
    background: var(--hero-paper);
    color: var(--hero-ink);
    box-shadow: 0.3rem 0.3rem 0 var(--hero-ink);
  }

  .ledger-icon svg {
    width: clamp(1.7rem, 2.7vw, 2.35rem);
    height: clamp(1.7rem, 2.7vw, 2.35rem);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .ledger-row-copy {
    min-width: 0;
    display: grid;
    gap: clamp(0.55rem, 1vw, 0.75rem);
  }

  .ledger-row-copy h3 {
    margin: 0;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.7rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .ledger-row-copy p {
    max-width: 31rem;
    display: grid;
    justify-items: start;
    gap: 0.42rem;
    margin: 0;
    color: inherit;
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    font-weight: 700;
    line-height: 1.36;
  }

  .ledger-row-copy code {
    display: inline-block;
    max-width: 100%;
    border: 2px solid currentColor;
    border-radius: 0.48rem;
    padding: 0.08rem 0.35rem 0.12rem;
    overflow-wrap: anywhere;
    color: inherit;
    background: color-mix(in srgb, currentColor 10%, transparent);
    font-family: var(--font-code);
    font-size: 0.86em;
    font-weight: 760;
    line-height: 1.2;
  }

  @media (max-width: 62rem) {
    .plugin-customization {
      --landing-section-max: 54rem;
      padding-top: clamp(3.75rem, 10vw, 5rem);
    }

    .plugin-customization::before {
      inset: clamp(1rem, 4vw, 2rem) 0 auto auto;
      width: min(16rem, 38vw);
    }

    .plugin-customization-heading {
      justify-items: start;
      text-align: left;
    }

    .capability-ledger {
      border-width: 2px;
