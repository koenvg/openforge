<div class="hero-visual" data-vgpu-visual>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-visual-fallback" aria-hidden="true">
    <div class="fallback-building">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <i></i>
    </div>
  </div>
  <div class="hero-build-label hero-build-label-top" aria-hidden="true">
    <span></span>
    5 plugins installed
  </div>
  <div class="hero-build-label hero-build-label-bottom" aria-hidden="true">
    <span></span>
    SDK v1 · stable core
  </div>
</div>

<script>
  import { startHeroCanvas } from '../../lib/heroCanvasController';
  import { getHeroCanvasPolicy } from '../../lib/heroCanvasPolicy';

  const visual = document.querySelector<HTMLElement>('[data-vgpu-visual]');
  const canvas = visual?.querySelector<HTMLCanvasElement>('canvas');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const usesCompactRendering = window.matchMedia('(max-width: 42rem), (pointer: coarse)').matches;
  const policy = getHeroCanvasPolicy({ prefersReducedMotion, usesCompactRendering });

  if (visual && canvas && 'gpu' in navigator) {
    void startHeroCanvas({ visual, canvas, policy });
  }
</script>
