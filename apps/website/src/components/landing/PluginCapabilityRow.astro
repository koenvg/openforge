---
import type { PluginCapability } from '../../lib/landingContent';

interface Props {
  capability: PluginCapability;
}

const { capability } = Astro.props;
---

<li class="ledger-row" data-extension-card>
  <span class="ledger-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      {capability.iconPaths.map((path) => <path d={path} />)}
    </svg>
  </span>
  <div class="ledger-row-copy">
    <h3>{capability.title}</h3>
    <p><code>{capability.code}</code><span>{capability.description}</span></p>
  </div>
</li>
