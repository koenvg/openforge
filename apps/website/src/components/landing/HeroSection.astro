---
import { HERO_CTA_LINKS } from '../../lib/landingContent';
import HeroCanvas from './HeroCanvas.astro';
import LandingActions from './LandingActions.astro';
import SiteHeader from './SiteHeader.astro';
---

<div class="hero-shell">
  <SiteHeader />

  <section class="hero" aria-describedby="hero-description" data-animate-section>
    <div class="hero-grid-lines" aria-hidden="true"></div>

    <div class="hero-copy">
      <h1 id="hero-title" data-animate-item>
        Orchestrate the work.<br />
        <span>Keep the judgment.</span>
      </h1>
      <p id="hero-description" class="lede" data-animate-item>
        Run coding agents in parallel, follow every task, and review the changes before they land.
      </p>

      <LandingActions links={HERO_CTA_LINKS} ariaLabel="Primary actions" class="hero-actions" animateItem />

      <div class="hero-proof" data-animate-item aria-label="Supported coding agents">
        <span>Works with</span>
        <ul>
          <li>Claude Code</li>
          <li>Codex</li>
          <li>Pi</li>
          <li>OpenCode</li>
        </ul>
      </div>
    </div>

    <HeroCanvas />

    <div class="hero-status-strip" aria-label="Example agent activity">
      <div>
        <span class="status-dot"></span>
        <strong>3</strong>
        running
      </div>
      <div>
        <strong>2</strong>
        ready for review
      </div>
      <div>
        <strong>1</strong>
        needs a decision
      </div>
    </div>
  </section>
</div>
