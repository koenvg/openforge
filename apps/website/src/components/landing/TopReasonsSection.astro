---
import { TOP_REASONS } from '../../lib/landingContent';
import SectionHeading from '../common/SectionHeading.astro';
import TopReasonCard from './TopReasonCard.astro';
---

<section class="landing-section top-reasons" aria-labelledby="top-reasons-title" data-animate-section>
  <SectionHeading title="Three ways to keep agent work reviewable" titleId="top-reasons-title" />

  <ol class="reason-rail" aria-label="Top reasons to use OpenForge">
    {TOP_REASONS.map((reason, index) => <TopReasonCard reason={reason} index={index} />)}
  </ol>
</section>
