<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    const heroTimeline = gsap.timeline({ defaults: { ease: 'power3.out' } });
    heroTimeline
      .from('.site-header', { autoAlpha: 0, y: -12, duration: 0.45 })
      .from('#hero-title', { autoAlpha: 0, y: 30, duration: 0.78 }, 0.14)
      .from('.hero .lede', { autoAlpha: 0, y: 20, duration: 0.58 }, 0.3)
      .from('.hero-actions .button', { autoAlpha: 0, y: 14, duration: 0.46, stagger: 0.06 }, 0.42)
      .from('.hero-proof', { autoAlpha: 0, y: 12, duration: 0.45 }, 0.54)
      .from('.hero-visual', { autoAlpha: 0, scale: 0.97, duration: 0.8 }, 0.2)
      .from('.hero-status-strip', { autoAlpha: 0, y: 18, duration: 0.5 }, 0.66);

    document.querySelectorAll<HTMLElement>('.landing-section').forEach((section) => {
      const heading = section.querySelector<HTMLElement>('.section-heading, .plugin-customization-heading');
      if (heading) {
        gsap.from(heading.children, {
          autoAlpha: 0,
          y: 20,
          duration: 0.55,
          ease: 'power3.out',
          stagger: 0.06,
          scrollTrigger: { trigger: heading, start: 'top 82%', once: true },
        });
      }
    });

    gsap.from('.reason-card', {
      autoAlpha: 0,
      y: 28,
      duration: 0.62,
      ease: 'power3.out',
      stagger: 0.09,
      scrollTrigger: { trigger: '.reason-rail', start: 'top 80%', once: true },
    });

    gsap.from('[data-product-window]', {
      autoAlpha: 0,
      y: 34,
      scale: 0.98,
      duration: 0.72,
      ease: 'power3.out',
      stagger: 0.14,
      scrollTrigger: { trigger: '.product-stage', start: 'top 76%', once: true },
    });

    gsap.from('.product-facts li', {
      autoAlpha: 0,
      y: 16,
      duration: 0.42,
      ease: 'power3.out',
      stagger: 0.05,
      scrollTrigger: { trigger: '.product-facts', start: 'top 88%', once: true },
    });

    const pluginTimeline = gsap.timeline({
      scrollTrigger: { trigger: '.plugin-building', start: 'top 78%', once: true },
      defaults: { ease: 'power3.out' },
    });
    pluginTimeline
      .from('[data-plugin-core]', { autoAlpha: 0, y: 22, duration: 0.44 })
      .from('[data-plugin-node]', {
        autoAlpha: 0,
        y: 44,
        scale: 0.97,
        duration: 0.48,
        stagger: { each: 0.08, from: 'end' },
      }, 0.16)
      .from('[data-building-piece]', { autoAlpha: 0, y: -26, duration: 0.42 }, 0.48);

    gsap.from('.final-cta-copy > *', {
      autoAlpha: 0,
      y: 18,
      duration: 0.52,
      ease: 'power3.out',
      stagger: 0.07,
      scrollTrigger: { trigger: '.final-cta', start: 'top 78%', once: true },
    });
  }
</script>
