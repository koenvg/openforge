---
import '../styles/global.css';

type MetadataUrl = string | URL;

interface Props {
  title: string;
  description: string;
  canonical: MetadataUrl;
  siteName?: string;
}

const { title, description, canonical, siteName = 'OpenForge' } = Astro.props;
const canonicalUrl = resolveMetadataUrl(canonical, Astro.site);
const appIconPath = '/app-icon.svg';
const touchIconPath = '/apple-touch-icon.png';
const socialImageUrl = resolveMetadataUrl(touchIconPath, Astro.site);

function resolveMetadataUrl(value: MetadataUrl, site: URL | undefined): string | undefined {
  if (value instanceof URL) {
    return value.toString();
  }

  const trimmed = value.trim();

  if (!trimmed) {
    return undefined;
  }

  if (/^https?:\/\//i.test(trimmed)) {
    return new URL(trimmed).toString();
  }

  return site ? new URL(trimmed, site).toString() : undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={appIconPath} />
    <link rel="apple-touch-icon" href={touchIconPath} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {socialImageUrl ? <meta property="og:image" content={socialImageUrl} /> : null}
    {socialImageUrl ? <meta name="twitter:image" content={socialImageUrl} /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
