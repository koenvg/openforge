---
import '../styles/global.css';

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="OpenForge is a local desktop command center for keeping AI coding-agent work visible, reviewable, and under human control."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>OpenForge — Run AI coding agents without losing control</title>
  </head>
  <body>
    <main aria-labelledby="hero-title">
      <div class="hero-shell">
        <header class="site-header" aria-label="OpenForge home">
          <a class="wordmark" href="/" aria-label="OpenForge home">OpenForge</a>
        </header>

        <section class="hero" aria-describedby="hero-description" data-animate-section>
          <div class="hero-copy">
            <h1 id="hero-title" data-animate-item>Ship with agents. Review like a human.</h1>
            <p id="hero-description" class="lede" data-animate-item>
              OpenForge turns parallel AI coding work into clear tasks, handoffs, and approvals.
            </p>

            <div class="actions hero-actions" aria-label="Primary actions" data-animate-item>
              <a class="button button-primary" href="https://github.com/koenvg/openforge/releases" aria-label="Install OpenForge from releases">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="button-icon download-icon">
                  <path d="M12 3v11" />
                  <path d="m7.5 9.5 4.5 4.5 4.5-4.5" />
                  <path d="M5 18.5h14" />
                </svg>
                Install OpenForge
              </a>
              <a class="button button-secondary" href="https://github.com/koenvg/openforge" aria-label="View OpenForge on GitHub">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="button-icon">
                  <path
                    fill="currentColor"
                    d="M12 .5A11.5 11.5 0 0 0 8.36 22.4c.58.11.8-.25.8-.56v-2.17c-3.25.71-3.94-1.38-3.94-1.38-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.6-.3-5.33-1.3-5.33-5.77 0-1.27.46-2.31 1.2-3.13-.12-.3-.52-1.52.12-3.08 0 0 .98-.31 3.2 1.2a11.1 11.1 0 0 1 5.84 0c2.22-1.51 3.2-1.2 3.2-1.2.64 1.56.24 2.78.12 3.08.75.82 1.2 1.86 1.2 3.13 0 4.48-2.74 5.47-5.35 5.76.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
                  />
                </svg>
                See GitHub
              </a>
            </div>
          </div>

          <div class="bento-stage" aria-label="Task, agent, handoff, and review workflow">
            <article class="bento-card bento-card-task">
              <span class="bento-label">Task</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 7h10" />
                <path d="M8 12h10" />
                <path d="M8 17h10" />
                <path d="m3.5 7 1 1 2-2" />
                <path d="m3.5 12 1 1 2-2" />
                <path d="m3.5 17 1 1 2-2" />
              </svg>
              <p>Define clear work.</p>
            </article>

            <article class="bento-card bento-card-agent">
              <span class="bento-label">Agent</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 9a4 4 0 0 1 8 0v3a4 4 0 0 1-8 0Z" />
                <path d="M9 16h6" />
                <path d="M12 3v2" />
                <path d="M5 11H3" />
                <path d="M21 11h-2" />
                <path d="M10 10h.01" />
                <path d="M14 10h.01" />
              </svg>
              <p>Run parallel agents.</p>
            </article>

            <article class="bento-card bento-card-handoff">
              <span class="bento-label">Handoff</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m7 8-4 4 4 4" />
                <path d="m17 8 4 4-4 4" />
                <path d="m14 4-4 16" />
              </svg>
              <p>Collect context and diffs.</p>
            </article>

            <article class="bento-card bento-card-review">
              <span class="bento-label">Review</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                <circle cx="12" cy="12" r="3" />
                <path d="m15.5 17.5 1.5 1.5 3-3" />
              </svg>
              <p>Approve with confidence.</p>
            </article>

            <span class="flow-arrow flow-arrow-task-agent" aria-hidden="true">
              <span class="flow-line"></span>
              <span class="flow-dot">→</span>
            </span>
            <span class="flow-arrow flow-arrow-agent-handoff" aria-hidden="true">
              <span class="flow-line"></span>
              <span class="flow-dot">↓</span>
            </span>
            <span class="flow-arrow flow-arrow-handoff-review" aria-hidden="true">
              <span class="flow-line"></span>
              <span class="flow-dot">←</span>
            </span>
          </div>
        </section>
      </div>

      <section class="top-reasons" aria-labelledby="top-reasons-title" data-animate-section>
        <div class="section-heading">
          <h2 id="top-reasons-title" class="section-title">Three ways OpenForge keeps agent work reviewable</h2>
        </div>

        <ol class="reason-rail" aria-label="Top reasons to use OpenForge">
          <li class="reason-step">
            <article class="reason-card" data-animate-card>
              <span class="step-badge" aria-hidden="true">01</span>
              <h3>Stay in control of agent work.</h3>
              <p>Keep scoped changes, Handoff Notes, and review gates visible before work moves forward.</p>
            </article>
          </li>

          <li class="reason-step">
            <article class="reason-card" data-animate-card>
              <span class="step-badge" aria-hidden="true">02</span>
              <h3>Let agents manage OpenForge tasks through the CLI.</h3>
              <p>Agents can coordinate Task status and Handoff Notes from command-line workflows.</p>
            </article>
          </li>

          <li class="reason-step">
            <article class="reason-card" data-animate-card>
              <span class="step-badge" aria-hidden="true">03</span>
              <h3>Customize OpenForge to your workflow.</h3>
              <p>Add approved capabilities around the stable task-based operator console.</p>
            </article>
          </li>
        </ol>
      </section>

      <section class="product-proof" aria-labelledby="product-proof-title" data-animate-section>
        <div class="product-proof-copy">
          <h2 id="product-proof-title" class="section-title">See the work without chasing it</h2>
          <p class="proof-lede">
            OpenForge keeps task attention and review blockers in one quiet desktop surface.
          </p>
        </div>

        <figure class="proof-figure" aria-label="OpenForge Task Attention Pane screenshot">
          <div class="proof-screenshot-shell">
            <img
              class="proof-screenshot"
              src="/images/openforge-task-attention-pane.png"
              width="793"
              height="1020"
              loading="lazy"
              alt="OpenForge Task Attention Pane showing the current task, pull request review blockers, and reviewer comments"
            />
          </div>
        </figure>
      </section>

      <section class="plugin-customization" aria-labelledby="plugin-customization-title" data-animate-section>
        <div class="plugin-customization-heading">
          <h2 id="plugin-customization-title" class="section-title">Bring your workflow into OpenForge</h2>
          <p class="plugin-customization-lede">
            Approved extensions add workflow-specific surfaces around the same stable OpenForge Tasks.
          </p>
        </div>

        <div class="capability-ledger" aria-label="Extension customization examples">
          <ol class="ledger-list">
            <li class="ledger-row" data-animate-card>
              <span class="ledger-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M4 5.5h16v13H4z" />
                  <path d="M4 10h16" />
                  <path d="M9 10v8.5" />
                </svg>
              </span>
              <div class="ledger-row-copy">
                <h3>Your views</h3>
                <p><code>views.register</code> · project dashboards, review queues, repo lenses</p>
              </div>
              <span class="ledger-dot" aria-hidden="true"></span>
            </li>

            <li class="ledger-row" data-animate-card>
              <span class="ledger-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M5 4.5h14v15H5z" />
                  <path d="M10 4.5v15" />
                  <path d="M13 9h3" />
                  <path d="M13 13h3" />
                </svg>
              </span>
              <div class="ledger-row-copy">
                <h3>Your task context</h3>
                <p><code>taskPane.registerTab</code> · notes, checklists, docs, review rituals</p>
              </div>
              <span class="ledger-dot" aria-hidden="true"></span>
            </li>

            <li class="ledger-row" data-animate-card>
              <span class="ledger-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M6 16.5a3.5 3.5 0 0 1 0-7 5.5 5.5 0 0 1 10.7-1.8A4.2 4.2 0 1 1 18 16.5h-2.2" />
                  <path d="M9 16.5h3" />
                  <path d="m11 13.5 3 3-3 3" />
                </svg>
              </span>
              <div class="ledger-row-copy">
                <h3>Your automations</h3>
                <p><code>background.register</code> · handoffs, CI, stale work, recurring prompts</p>
              </div>
              <span class="ledger-dot" aria-hidden="true"></span>
            </li>

            <li class="ledger-row" data-animate-card>
              <span class="ledger-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M12 3 20 6.5v5.7c0 4.5-3.1 7.4-8 8.8-4.9-1.4-8-4.3-8-8.8V6.5L12 3Z" />
                  <path d="m8.8 12.1 2 2 4.6-4.8" />
                </svg>
              </span>
              <div class="ledger-row-copy">
                <h3>Your host capabilities</h3>
                <p><code>tasks · fs · shell · notifications</code> · explicit access for approved extensions</p>
              </div>
              <span class="ledger-dot" aria-hidden="true"></span>
            </li>
          </ol>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="final-cta-title" data-animate-section>
        <div class="final-cta-copy">
          <h2 id="final-cta-title" class="section-title">Bring OpenForge to your desktop</h2>
          <p class="final-cta-lede">
            Install the local command center for visible, reviewable agent work.
          </p>

          <div class="actions final-cta-actions" aria-label="Final actions">
            <a class="button button-primary" href="https://github.com/koenvg/openforge/releases" aria-label="Install OpenForge from releases">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="button-icon download-icon">
                <path d="M12 3v11" />
                <path d="m7.5 9.5 4.5 4.5 4.5-4.5" />
                <path d="M5 18.5h14" />
              </svg>
              Install OpenForge
            </a>
            <a class="button button-secondary" href="https://github.com/koenvg/openforge" aria-label="View OpenForge source on GitHub">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="button-icon github-icon">
                <path
                  fill="currentColor"
                  d="M12 .5A11.5 11.5 0 0 0 8.36 22.4c.58.11.8-.25.8-.56v-2.17c-3.25.71-3.94-1.38-3.94-1.38-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.6-.3-5.33-1.3-5.33-5.77 0-1.27.46-2.31 1.2-3.13-.12-.3-.52-1.52.12-3.08 0 0 .98-.31 3.2 1.2a11.1 11.1 0 0 1 5.84 0c2.22-1.51 3.2-1.2 3.2-1.2.64 1.56.24 2.78.12 3.08.75.82 1.2 1.86 1.2 3.13 0 4.48-2.74 5.47-5.35 5.76.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
                />
              </svg>
              GitHub
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" aria-label="OpenForge footer">
      <div class="footer-brand">
        <a class="footer-wordmark" href="/" aria-label="OpenForge home">OpenForge</a>
        <p>Local-first tools for visible, reviewable agent work.</p>
      </div>

      <nav class="footer-links" aria-label="Stable OpenForge links">
        <ul>
          <li>
            <span class="footer-link-label">Install</span>
            <a href="https://github.com/koenvg/openforge/releases">
              Releases
              <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <span class="footer-link-label">Source</span>
            <a href="https://github.com/koenvg/openforge">
              GitHub
              <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <span class="footer-link-label">Docs</span>
            <a href="https://github.com/koenvg/openforge#readme">
              README
              <span aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <span class="footer-link-label">Orientation</span>
            <a href="https://github.com/koenvg/openforge#why-open-forge-exists">
              Project orientation
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </nav>
    </footer>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        gsap.registerPlugin(ScrollTrigger);

        const heroTimeline = gsap.timeline({ defaults: { ease: 'power3.out' } });
        heroTimeline
          .from('.wordmark', { autoAlpha: 0, y: -12, duration: 0.45 })
          .from('#hero-title', { autoAlpha: 0, y: 34, rotate: -1.5, duration: 0.75 }, 0.05)
          .from('.lede', { autoAlpha: 0, y: 22, duration: 0.62 }, 0.24)
          .from('.hero-actions .button', { autoAlpha: 0, y: 18, scale: 0.96, duration: 0.5, stagger: 0.07 }, 0.42)
          .from('.bento-card', {
            autoAlpha: 0,
            y: 34,
            scale: 0.92,
            rotate: -2,
            duration: 0.72,
            ease: 'back.out(1.25)',
            stagger: 0.08
          }, 0.28)
          .from('.flow-line', { scaleX: 0, scaleY: 0, duration: 0.36, stagger: 0.08, transformOrigin: 'center center' }, 0.86)
          .from('.flow-dot', { autoAlpha: 0, scale: 0.35, duration: 0.34, ease: 'back.out(2)', stagger: 0.08 }, 0.96);

        gsap.to('.bento-card', {
          y: -6,
          duration: 2.8,
          delay: 1.25,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
          stagger: { each: 0.14 }
        });

        gsap.utils.toArray<HTMLElement>('[data-animate-section]').forEach((section) => {
          if (section.classList.contains('hero')) return;

          const cards = section.querySelectorAll<HTMLElement>('[data-animate-card], .proof-screenshot-shell, .final-cta-copy');

          if (cards.length === 0) return;

          gsap.from(cards, {
            autoAlpha: 0,
            y: 18,
            duration: 0.55,
            ease: 'power3.out',
            stagger: 0.07,
            scrollTrigger: {
              trigger: section,
              start: 'top 78%',
              once: true
            }
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .hero-shell {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: clamp(1.25rem, 2.7vw, 3rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 9% 88%, rgba(255, 255, 255, 0.28) 0 0.18rem, transparent 0.2rem) 0 0 / 2rem 2rem,
      linear-gradient(124deg, #0437e8 0 51%, #fff8df 51% 100%);
    color: #05070d;
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  }

  .site-header {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .wordmark {
    position: relative;
    z-index: 2;
    color: #fff8df;
    font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    font-size: clamp(1.35rem, 1.8vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
    text-shadow: 0 0.18rem 0 rgba(5, 7, 13, 0.18);
  }

  .hero {
    position: relative;
    width: min(100%, 99rem);
    min-height: calc(100dvh - 5rem);
    display: grid;
    grid-template-columns: minmax(24rem, 0.92fr) minmax(28rem, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 5rem);
    margin: 0 auto;
  }

  .hero::after {
    content: "";
    position: absolute;
    right: max(-8vw, -7rem);
    bottom: max(-10vw, -9rem);
    width: min(28rem, 34vw);
    aspect-ratio: 1;
    border-radius: 32% 68% 0 0;
    background: #05070d;
    transform: rotate(-18deg);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(100%, 47rem);
    padding-block: clamp(3rem, 7vh, 5.5rem);
  }

  h1 {
    max-width: 10.6em;
    margin: 0;
    color: #fff8df;
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(3.8rem, 6.25vw, 6.55rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.052em;
    text-wrap: balance;
    text-shadow: 0 0.22rem 0 rgba(5, 7, 13, 0.18);
  }

  .lede {
    max-width: 39rem;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    color: rgba(255, 248, 223, 0.92);
    font-size: clamp(1.16rem, 1.45vw, 1.45rem);
    font-weight: 500;
    line-height: 1.48;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .button {
    min-height: 3.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    border: 1.5px solid var(--line);
    border-radius: 0.55rem;
    padding: 0 2rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    border-color: var(--green);
    background: linear-gradient(180deg, #128341, var(--green));
    box-shadow: 0 1rem 2rem rgba(15, 111, 56, 0.18);
    color: #ffffff;
  }

  .button-primary:hover {
    box-shadow: 0 1.25rem 2.5rem rgba(15, 111, 56, 0.24);
  }

  .button-secondary {
    background: rgba(255, 250, 240, 0.62);
  }

  .button-secondary:hover {
    border-color: var(--green);
    background: rgba(255, 250, 240, 0.88);
  }

  .hero .button {
    min-height: clamp(3.6rem, 5vw, 4.6rem);
    border: 2px solid #05070d;
    border-radius: 0.8rem;
    padding-inline: clamp(1.4rem, 2.4vw, 2.35rem);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    font-weight: 750;
    box-shadow: 0 0.55rem 0 rgba(5, 7, 13, 0.25);
  }

  .hero .button-primary {
    background: #05070d;
    color: #fff8df;
  }

  .hero .button-secondary {
    background: #fff8df;
    color: #05070d;
  }

  .hero .button:hover {
    box-shadow: 0 0.7rem 0 rgba(5, 7, 13, 0.28);
  }

  .button-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .bento-stage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) clamp(2.65rem, 3.4vw, 3.25rem) minmax(12rem, 1fr);
    grid-template-rows: minmax(12.5rem, 1fr) clamp(2.65rem, 3.4vw, 3.25rem) minmax(12.5rem, 1fr);
    gap: clamp(0.55rem, 1vw, 0.95rem);
    align-items: stretch;
  }

  .bento-stage::before {
    content: "";
    position: absolute;
    inset: -4rem -6rem -3rem 7%;
    z-index: -1;
    border-radius: 5rem 0 0 5rem;
    background: #fff8df;
    transform: skewX(-11deg);
  }

  .bento-card {
    position: relative;
    min-height: clamp(12.5rem, 16vw, 16rem);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(0.7rem, 1.1vw, 1rem);
    border: 3px solid #05070d;
    border-radius: 1.2rem;
    padding: clamp(1rem, 1.65vw, 1.45rem);
    box-shadow: 0.48rem 0.48rem 0 #05070d;
    color: #05070d;
    text-align: center;
  }

  .bento-card-task {
    grid-column: 1;
    grid-row: 1;
    background: #ff5757;
  }

  .bento-card-agent {
    grid-column: 3;
    grid-row: 1;
    background: #c9ff39;
  }

  .bento-card-handoff {
    grid-column: 3;
    grid-row: 3;
    background: #6a5cff;
  }

  .bento-card-review {
    grid-column: 1;
    grid-row: 3;
    background: #ffd43b;
  }

  .flow-arrow {
    position: relative;
    z-index: 4;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .flow-line {
    position: absolute;
    border-radius: 999rem;
    background: #05070d;
  }

  .flow-dot {
    position: relative;
    z-index: 2;
    width: clamp(2.35rem, 3.25vw, 3rem);
    height: clamp(2.35rem, 3.25vw, 3rem);
    display: grid;
    place-items: center;
    border: 3px solid #05070d;
    border-radius: 999rem;
    background: #05070d;
