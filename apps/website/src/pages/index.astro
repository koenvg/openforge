---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCtaSection from '../components/landing/FinalCtaSection.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import LandingPageScripts from '../components/landing/LandingPageScripts.astro';
import LandingPageStyles from '../components/landing/LandingPageStyles.astro';
import PluginCustomizationSection from '../components/landing/PluginCustomizationSection.astro';
import ProductProofSection from '../components/landing/ProductProofSection.astro';
import TopReasonsSection from '../components/landing/TopReasonsSection.astro';
import { HOME_PATH } from '../lib/urls';

const pageTitle = 'OpenForge — The desktop control plane for coding agents';
const pageDescription = 'Run coding agents in parallel, follow every task, and review the changes before they land with OpenForge.';
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={HOME_PATH}>
  <main aria-labelledby="hero-title">
    <HeroSection />
    <TopReasonsSection />
    <ProductProofSection />
    <PluginCustomizationSection />
    <FinalCtaSection />
  </main>

  <LandingPageScripts />
  <LandingPageStyles />
</BaseLayout>
