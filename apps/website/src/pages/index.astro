---
import '../styles/global.css';

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="OpenForge is a local desktop command center for keeping AI coding-agent work visible, reviewable, and under human control."
    />
    <title>OpenForge — Run AI coding agents without losing control</title>
  </head>
  <body>
    <main aria-labelledby="hero-title">
      <div class="hero-shell">
        <header class="site-header" aria-label="OpenForge home">
          <a class="wordmark" href="/" aria-label="OpenForge home">OpenForge</a>
        </header>

        <section class="hero" aria-describedby="hero-description">
          <div class="hero-copy">
            <h1 id="hero-title">Run AI coding<br />agents without losing<br />control of the work</h1>
            <p id="hero-description" class="lede">
              OpenForge keeps the work local, visible, and ready for human review.
            </p>

            <div class="actions" aria-label="Primary actions">
              <a class="button button-primary" href="https://github.com/koenvg/openforge/releases" aria-label="Install OpenForge from releases">
                Install OpenForge
              </a>
              <a class="button button-secondary" href="https://github.com/koenvg/openforge" aria-label="View OpenForge on GitHub">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="button-icon">
                  <path
                    fill="currentColor"
                    d="M12 .5A11.5 11.5 0 0 0 8.36 22.4c.58.11.8-.25.8-.56v-2.17c-3.25.71-3.94-1.38-3.94-1.38-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.6-.3-5.33-1.3-5.33-5.77 0-1.27.46-2.31 1.2-3.13-.12-.3-.52-1.52.12-3.08 0 0 .98-.31 3.2 1.2a11.1 11.1 0 0 1 5.84 0c2.22-1.51 3.2-1.2 3.2-1.2.64 1.56.24 2.78.12 3.08.75.82 1.2 1.86 1.2 3.13 0 4.48-2.74 5.47-5.35 5.76.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
                  />
                </svg>
                GitHub
              </a>
            </div>
          </div>

          <div class="approval-stage" aria-label="Task to review workflow illustration">
            <img
              class="hero-visual-image"
              src="/images/openforge-approval-workflow.png"
              width="1100"
              height="500"
              alt="Task, agent, handoff, and review workflow with a human approval gate and diff summary"
            />
          </div>
        </section>
      </div>

      <section class="top-reasons" aria-labelledby="top-reasons-title">
        <div class="section-heading">
          <p class="eyebrow">Top reasons</p>
          <h2 id="top-reasons-title" class="section-title">Top reasons to use OpenForge</h2>
        </div>

        <ol class="reason-rail" aria-label="Top reasons to use OpenForge">
          <li class="reason-step">
            <article class="reason-card">
              <span class="step-badge" aria-hidden="true">01</span>
              <div class="reason-visual control-visual" aria-hidden="true">
                <div class="visual-window">
                  <div class="visual-header">
                    <span>src/task-review.ts</span>
                    <span class="status-pill amber-pill">Review</span>
                  </div>
                  <div class="diff-row removed-line"><span>−</span><span>skip handoff notes</span></div>
                  <div class="diff-row added-line"><span>+</span><span>require review gate</span></div>
                  <div class="review-actions">
                    <span>Awaiting human review</span>
                    <span class="status-pill green-pill">Approve</span>
                  </div>
                </div>
              </div>
              <h3>Stay in control of agent work.</h3>
              <p>Keep scoped changes, Handoff Notes, and review gates visible before work moves forward.</p>
            </article>
          </li>

          <li class="reason-step">
            <article class="reason-card">
              <span class="step-badge" aria-hidden="true">02</span>
              <div class="reason-visual cli-visual" aria-hidden="true">
                <div class="terminal-window">
                  <div class="terminal-bar"><span></span><span></span><span></span></div>
                  <code>$ openforge list-tasks --state doing</code>
                  <code>$ openforge update-task --task-id KVG-1474</code>
                  <code class="terminal-result">✓ Task handoff updated · ready for review</code>
                </div>
              </div>
              <h3>Let agents manage OpenForge tasks through the CLI.</h3>
              <p>Agents can coordinate Task status and Handoff Notes from command-line workflows.</p>
            </article>
          </li>

          <li class="reason-step">
            <article class="reason-card">
              <span class="step-badge" aria-hidden="true">03</span>
              <div class="reason-visual plugin-visual" aria-hidden="true">
                <div class="plugin-boundary">
                  <div class="boundary-title">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3 20 6.5v5.7c0 4.5-3.1 7.4-8 8.8-4.9-1.4-8-4.3-8-8.8V6.5L12 3Z" />
                      <path d="m8.8 12.1 2 2 4.6-4.8" />
                    </svg>
                    Trusted Plugin boundary
                  </div>
                  <div class="plugin-chip-grid">
                    <span>Review checklist</span>
                    <span>Repo insights</span>
                    <span>Task labels</span>
                    <span>Handoff helpers</span>
                  </div>
                </div>
              </div>
              <h3>Customize OpenForge to your workflow with Trusted Plugins.</h3>
              <p>Add approved capabilities around the stable task-based operator console.</p>
            </article>
          </li>
        </ol>
      </section>
    </main>
  </body>
</html>

<style>
  .hero-shell {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: clamp(1.5rem, 3vw, 3.25rem);
    overflow: hidden;
  }

  .site-header {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .wordmark {
    position: relative;
    z-index: 2;
    color: var(--ink);
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 760;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .hero {
    position: relative;
    width: min(100%, 99rem);
    min-height: calc(100dvh - 5rem);
    margin: 0 auto;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(55rem, 60vw);
    padding-top: clamp(2.25rem, 6vh, 3.6rem);
  }

  h1 {
    max-width: 8.75em;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.35rem, 5.75vw, 6.05rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.068em;
  }

  .lede {
    max-width: 31rem;
    margin: clamp(1.5rem, 3vw, 2.3rem) 0 0;
    color: var(--muted);
    font-size: clamp(1.2rem, 1.6vw, 1.7rem);
    line-height: 1.35;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .button {
    min-height: 3.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    border: 1.5px solid var(--line);
    border-radius: 0.55rem;
    padding: 0 2rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    border-color: var(--green);
    background: linear-gradient(180deg, #128341, var(--green));
    box-shadow: 0 1rem 2rem rgba(15, 111, 56, 0.18);
    color: #ffffff;
  }

  .button-primary:hover {
    box-shadow: 0 1.25rem 2.5rem rgba(15, 111, 56, 0.24);
  }

  .button-secondary {
    background: rgba(255, 250, 240, 0.62);
  }

  .button-secondary:hover {
    border-color: var(--green);
    background: rgba(255, 250, 240, 0.88);
  }

  .button-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .approval-stage {
    position: absolute;
    left: clamp(29rem, 29vw, 31rem);
    right: clamp(-3rem, -2vw, -1rem);
    bottom: clamp(1.25rem, 3.5vh, 2.5rem);
    min-height: min(31rem, 58vh);
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .approval-stage::before {
    content: "";
    position: absolute;
    inset: 7% -4% 2% 2%;
    z-index: -2;
    border-radius: 999rem;
    background:
      radial-gradient(circle at 54% 48%, rgba(191, 114, 0, 0.1), transparent 10rem),
      radial-gradient(circle at 36% 56%, rgba(15, 111, 56, 0.08), transparent 16rem);
    mask-image: linear-gradient(90deg, transparent, black 16%, black 82%, transparent);
  }

  .hero-visual-image {
    width: min(100%, 66.25rem);
    height: auto;
    display: block;
    user-select: none;
    mix-blend-mode: multiply;
    opacity: 0.98;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 3rem, #000 calc(100% - 2rem), transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 1.25rem, #000 calc(100% - 2rem), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0, #000 3rem, #000 calc(100% - 2rem), transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 1.25rem, #000 calc(100% - 2rem), transparent 100%);
    mask-composite: intersect;
  }

  .top-reasons {
    width: min(100% - clamp(2rem, 6vw, 6.5rem), 94rem);
    margin: 0 auto;
    padding: clamp(4.5rem, 8vw, 7.5rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .section-heading {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: var(--green-deep);
    font-size: 0.82rem;
    font-weight: 780;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-title {
    max-width: 13em;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 5vw, 5.1rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.058em;
  }

  .reason-rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 2.2vw, 2rem);
    margin: clamp(3.5rem, 6vw, 5.25rem) 0 0;
    padding: 4.25rem 0 0;
    list-style: none;
  }

  .reason-rail::before {
    content: "";
    position: absolute;
    top: 1.9rem;
    left: 1rem;
    right: 1rem;
    height: 1.5px;
    background: linear-gradient(90deg, transparent, rgba(15, 111, 56, 0.74) 9%, rgba(15, 111, 56, 0.74) 91%, transparent);
  }

  .reason-step {
    position: relative;
    min-width: 0;
  }

  .step-badge {
    position: absolute;
    top: -4.25rem;
    left: 50%;
    z-index: 2;
    width: 3.9rem;
    height: 3.9rem;
    display: grid;
    place-items: center;
    transform: translateX(-50%);
    border: 1.5px solid rgba(15, 111, 56, 0.72);
    border-radius: 999rem;
    background: rgba(255, 250, 240, 0.94);
    box-shadow: 0 0.85rem 1.7rem rgba(46, 36, 24, 0.12);
    color: var(--green-deep);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 1.15rem;
    font-weight: 760;
  }

  .reason-card {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    border: 1px solid rgba(30, 41, 59, 0.18);
    border-radius: 1rem;
    padding: clamp(1.05rem, 1.6vw, 1.55rem);
    background: rgba(255, 250, 240, 0.74);
    box-shadow: 0 1.5rem 4.5rem rgba(46, 36, 24, 0.1);
  }

  .reason-card h3 {
    margin: 0;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.65rem, 2.1vw, 2.25rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.052em;
  }

  .reason-card p {
    max-width: 27rem;
    margin: -0.55rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.5;
  }

  .reason-visual {
    min-height: 16rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(30, 41, 59, 0.12);
    border-radius: 0.75rem;
    background:
      radial-gradient(circle at 18% 18%, rgba(15, 111, 56, 0.08), transparent 9rem),
      rgba(247, 242, 232, 0.5);
    overflow: hidden;
  }

  .visual-window,
  .plugin-boundary {
    width: min(100% - 1.3rem, 23.5rem);
    border: 1px solid rgba(30, 41, 59, 0.18);
    border-radius: 0.6rem;
    background: rgba(255, 250, 240, 0.86);
    box-shadow: 0 0.9rem 2.5rem rgba(46, 36, 24, 0.08);
  }

  .visual-header,
  .review-actions,
  .boundary-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .visual-header {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(30, 41, 59, 0.12);
    color: var(--muted);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.78rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 999rem;
    padding: 0.25rem 0.55rem;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 730;
    line-height: 1;
  }

  .amber-pill {
    color: var(--amber);
    background: rgba(191, 114, 0, 0.08);
  }

  .green-pill {
    color: var(--green-deep);
    background: rgba(15, 111, 56, 0.08);
  }

  .diff-row {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.82rem;
  }

  .removed-line {
    background: rgba(191, 114, 0, 0.1);
    color: var(--amber);
  }

  .added-line {
    background: rgba(15, 111, 56, 0.1);
    color: var(--green-deep);
  }

  .review-actions {
    margin: 1rem;
    border: 1px solid rgba(15, 111, 56, 0.24);
    border-radius: 0.5rem;
    padding: 0.85rem;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 650;
  }

  .terminal-window {
    width: min(100% - 1.35rem, 24rem);
    display: grid;
    gap: 0.85rem;
    border: 1px solid rgba(30, 41, 59, 0.32);
    border-radius: 0.65rem;
    padding: 0.85rem 1rem 1.1rem;
    background: var(--ink);
    box-shadow: 0 1.1rem 3rem rgba(16, 21, 31, 0.2);
    color: var(--paper);
  }

  .terminal-bar {
    display: flex;
    gap: 0.4rem;
    padding-bottom: 0.25rem;
  }

  .terminal-bar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999rem;
    background: rgba(255, 250, 240, 0.42);
  }

  .terminal-window code {
    display: block;
    color: var(--paper);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: clamp(0.74rem, 0.88vw, 0.86rem);
    line-height: 1.45;
    white-space: normal;
  }

  .terminal-result {
    color: rgba(255, 250, 240, 0.72) !important;
  }

  .plugin-boundary {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-style: dashed;
    border-color: rgba(15, 111, 56, 0.42);
  }

  .boundary-title {
    justify-content: center;
    color: var(--green-deep);
    font-size: 0.86rem;
    font-weight: 720;
  }

  .boundary-title svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .plugin-chip-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .plugin-chip-grid span {
    min-height: 3.5rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(30, 41, 59, 0.12);
    border-radius: 0.55rem;
    padding: 0.65rem;
    background: rgba(255, 250, 240, 0.72);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 680;
    text-align: center;
  }

  .approval-label {
    position: absolute;
    top: 22%;
    left: 49%;
    color: var(--amber);
    font-size: clamp(0.94rem, 1vw, 1.08rem);
    font-weight: 740;
    letter-spacing: -0.025em;
  }

  .workflow {
    position: relative;
    z-index: 5;
    width: min(100%, 74rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
    gap: clamp(2.6rem, 3.6vw, 5.2rem);
    transform: translateY(-0.2rem);
  }

  .workflow::before {
    content: "";
    position: absolute;
    top: 2.95rem;
    left: 8%;
    right: 7%;
    height: 1.35px;
    z-index: -1;
    background: linear-gradient(90deg, var(--line-soft), rgba(15, 111, 56, 0.46), var(--line-soft));
  }

  .workflow-node {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    color: var(--ink);
    text-align: center;
  }

  .node-icon {
    width: clamp(4.4rem, 5.3vw, 5.6rem);
    height: clamp(4.4rem, 5.3vw, 5.6rem);
    display: grid;
    place-items: center;
    border: 1.5px solid rgba(16, 21, 31, 0.72);
    border-radius: 999rem;
    background: rgba(255, 250, 240, 0.72);
    box-shadow: 0 1rem 2.5rem rgba(46, 36, 24, 0.08);
  }

  .node-icon svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .node-label {
    margin-top: 0.3rem;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    font-weight: 760;
  }

  .node-title {
    max-width: 9rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.3;
  }

  .handoff-node {
    transform: translateX(8%);
  }

  .review-node .node-icon {
    border-color: rgba(191, 114, 0, 0.78);
    background: linear-gradient(180deg, #fff4d9, #f5dcab);
    box-shadow: 0 1.4rem 3rem rgba(191, 114, 0, 0.16);
  }

  .gate {
    position: absolute;
    left: 51%;
    top: 45%;
    z-index: 6;
    transform: translate(-3%, -50%);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.54rem 0.68rem;
    border: 1px solid rgba(191, 114, 0, 0.36);
    border-radius: 999rem;
    background: rgba(255, 250, 240, 0.9);
    box-shadow: 0 1rem 2.6rem rgba(79, 52, 12, 0.12);
  }

  .gate-track {
    width: 5.8rem;
    height: 2.55rem;
    display: block;
    border: 1.5px solid rgba(191, 114, 0, 0.75);
    border-radius: 999rem;
    background: linear-gradient(90deg, #f3d296, #fff6de);
  }

  .gate-thumb {
    width: 2.15rem;
    height: 2.15rem;
    display: block;
    margin: 0.17rem 0.22rem 0 auto;
    border: 1.5px solid rgba(79, 52, 12, 0.5);
    border-radius: 999rem;
    background: #fffaf0;
    box-shadow: 0 0.4rem 1rem rgba(79, 52, 12, 0.16);
  }

  .gate-copy {
    color: var(--amber);
    font-size: 0.86rem;
    font-weight: 760;
  }

  .approval-hand {
    position: absolute;
    left: 58%;
    top: 40%;
    z-index: 4;
    width: clamp(15rem, 21vw, 20.5rem);
    height: auto;
    color: rgba(16, 21, 31, 0.48);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
    transform: rotate(-5deg);
    filter: drop-shadow(0 1.1rem 1.4rem rgba(46, 36, 24, 0.1));
  }

  .hand-fill {
    fill: rgba(255, 250, 240, 0.34);
    stroke: rgba(16, 21, 31, 0.3);
  }

  .hand-detail {
    stroke: rgba(16, 21, 31, 0.22);
    stroke-width: 1.5;
  }

  .diff-slip {
    position: absolute;
    left: 13%;
    bottom: -8%;
    z-index: 3;
    width: min(24rem, 46vw);
    transform: rotate(-3deg);
    display: grid;
    gap: 0.42rem;
    border: 1px solid rgba(30, 41, 59, 0.1);
    border-radius: 0.45rem;
    padding: 1rem 1.1rem;
    background: rgba(255, 250, 240, 0.88);
    box-shadow: var(--shadow);
    color: var(--ink);
    font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    font-size: clamp(0.76rem, 1vw, 0.95rem);
  }

  .diff-title {
    color: var(--muted);
    font-size: 0.78em;
  }

  .diff-line {
    white-space: nowrap;
  }

  .removed {
    color: #a33c36;
  }

  .added {
    color: var(--green-deep);
  }

  @media (max-width: 62rem) {
    .hero-shell {
      min-height: auto;
      overflow: visible;
      padding: 1.25rem;
    }

    .hero {
      min-height: auto;
      display: grid;
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .hero-copy {
      width: 100%;
      padding-top: clamp(2rem, 6vw, 3rem);
    }

